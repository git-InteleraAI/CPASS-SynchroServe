runTest('5. BL Approved — displays BL Approved overall, Awaiting CEO Approval detail', () => {
  const statement = {
    cpass_status: 'BL_APPROVED',
    audit_status: 'SUBMITTED',
    review_stages: {
      ch: { status: 'Recommended' },
      cops: { status: 'Verified' },
