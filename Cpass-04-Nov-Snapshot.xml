  assert.ok('chStage' in res)
  assert.ok('copsStage' in res)
  assert.ok('blStage' in res)
  assert.ok('ceoStage' in res)
})

console.log(`\n========================================`)
console.log(`All ${passedTests}/${totalTests} unit tests passed successfully!`)
console.log(`========================================\n`)
