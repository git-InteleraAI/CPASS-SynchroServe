# -----------------------------------------------------------------------------
# 6. Cross-State Dashboard Scoping Denial
# -----------------------------------------------------------------------------
def test_cross_state_dashboard_access_denied():
    """Verify an L1 or L2 assigned to Andhra Pradesh cannot access Tamil Nadu dashboard."""
    l1_ap = CurrentUser(
        id="l1-ap-id",
