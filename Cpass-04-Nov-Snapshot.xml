  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  box-shadow: 0 1px 4px rgba(15, 23, 42, 0.04);
}

.l4-dossier-header-left {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.l4-btn-back {
  background: #f1f5f9;
  border: 1px solid #cbd5e1;
  color: #334155;
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
}

.l4-btn-back:hover {
  background: #e2e8f0;
}

.l4-dossier-cand-info h3 {
  margin: 0;
  font-size: 1.2rem;
  font-weight: 700;
  color: #0f172a;
}

.l4-dossier-meta-tags {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 4px;
}

.l4-meta-tag {
  font-size: 0.78rem;
  color: #64748b;
  background: #f8fafc;
  padding: 2px 8px;
  border-radius: 4px;
  border: 1px solid #e2e8f0;
}

.l4-dossier-header-actions {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.l4-stage-progression-bar {
