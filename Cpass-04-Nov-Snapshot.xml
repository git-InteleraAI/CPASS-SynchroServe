  position: relative;
  background: #1e293b;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.cpass-pdf-scroll-viewport::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.cpass-pdf-pages-stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
  width: 100%;
}

.cpass-pdf-page-wrapper {
  position: relative;
  background: #ffffff;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
  border-radius: 4px;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 auto;
  max-width: 100%;
}

.cpass-pdf-page-canvas {
  display: block;
  max-width: 100%;
  height: auto;
}

.cpass-pdf-page-loader {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(2px);
}

.cpass-pdf-page-tag {
  position: absolute;
  bottom: 8px;
  right: 8px;
  background: rgba(15, 23, 42, 0.75);
  color: #f8fafc;
  font-size: 10.5px;
  font-weight: 500;
  padding: 2px 7px;
  border-radius: 4px;
  pointer-events: none;
  backdrop-filter: blur(4px);
}

/* Spinner and Status Screens */
.cpass-pdf-status-screen {
  flex: 1;
  min-height: 450px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30px;
  text-align: center;
  color: #f8fafc;
}

.cpass-pdf-status-screen h4 {
  margin: 14px 0 6px;
  font-size: 15px;
  font-weight: 600;
  color: #f8fafc;
}

.cpass-pdf-status-screen p {
  margin: 0;
  font-size: 13px;
  color: #94a3b8;
  max-width: 400px;
}

.cpass-pdf-status-screen.error h4 {
  color: #fca5a5;
}

.cpass-pdf-status-screen.error p {
  color: #fecaca;
}

.cpass-pdf-spinner {
  display: inline-block;
  width: 24px;
  height: 24px;
  border: 3px solid rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  border-top-color: #38bdf8;
  animation: cpassSpin 0.7s linear infinite;
}

.cpass-pdf-spinner.large {
  width: 36px;
  height: 36px;
  border-width: 3.5px;
}

@keyframes cpassSpin {
  to { transform: rotate(360deg); }
}

/* Dedicated Image Viewer Subcomponent Styles */
.cpass-image-viewer-inner {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  flex: 1;
}

.cpass-image-canvas-viewport {
  flex: 1;
  min-height: 480px;
  overflow: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: #1e293b;
}

.cpass-image-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
}

.cpass-image-element {
  display: block;
  max-width: 100%;
  max-height: 75vh;
  object-fit: contain;
  border-radius: 4px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
}

.cpass-image-element.fit-width {
  width: 100%;
  max-height: none;
}

