/* ==========================================================================
   CPASS L2 Centre Head Compact Dashboard Summary Cards (Top of Dashboard)
   Enterprise Design: Crisp White Surfaces, Subtle Accents, Responsive Grid
   ========================================================================== */

.l2-compact-summary-row {
