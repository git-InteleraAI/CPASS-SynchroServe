<file path=".github/workflows/deploy.yml">
name: CPASS Production CI/CD Deployment

on:
  push:
    branches:
      - main
  workflow_dispatch:

# Prevent race conditions from rapid successive commits
concurrency:
  group: production-deployment
  cancel-in-progress: false

permissions:
  id-token: write
  contents: read

env:
  AWS_REGION: ${{ vars.AWS_REGION || 'ap-south-1' }}

jobs:
  # ---------------------------------------------------------------------------
  # Stage 1: Quality Gate & Automated Testing
  # ---------------------------------------------------------------------------
  test:
    name: Run Automated Tests & Validations
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: "pip"

      - name: Install Backend Test Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r backend/requirements.txt pytest httpx

      - name: Run Backend Pytest Suites (19 suites)
        run: |
          cd backend
          pytest tests/

      - name: Set up Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"
          cache-dependency-path: frontend/package-lock.json

      - name: Install Frontend Dependencies
        run: |
          cd frontend
          npm ci

      - name: Run Frontend Helper Unit Tests
        run: |
          cd frontend
          node src/components/approvalStatusHelper.test.js
          node src/lib/bankStatementHelper.test.js
          node src/lib/salarySequenceHelper.test.js

      - name: Verify Frontend Production Build
        run: |
          cd frontend
          npm run build

  # ---------------------------------------------------------------------------
  # Stage 2: Build & Push Versioned Container Images to Amazon ECR
  # ---------------------------------------------------------------------------
  build-and-push:
    name: Build & Push Images to Amazon ECR
    needs: test
    runs-on: ubuntu-latest
    outputs:
      registry: ${{ steps.login-ecr.outputs.registry }}
      image_tag: ${{ steps.set-tag.outputs.tag }}

    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      - name: Set Version Tag
        id: set-tag
        run: echo "tag=${GITHUB_SHA}" >> $GITHUB_OUTPUT

      - name: Configure AWS Credentials via GitHub OIDC
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_TO_ASSUME }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Log in to Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      # Build and Push Backend Image
      - name: Build and Push Backend Image
        uses: docker/build-push-action@v5
        with:
          context: ./backend
          file: ./backend/Dockerfile
          push: true
          tags: |
            ${{ steps.login-ecr.outputs.registry }}/${{ vars.ECR_REPOSITORY_BACKEND || 'cpass-backend' }}:${{ steps.set-tag.outputs.tag }}
            ${{ steps.login-ecr.outputs.registry }}/${{ vars.ECR_REPOSITORY_BACKEND || 'cpass-backend' }}:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max

      # Build and Push Frontend Image
      - name: Build and Push Frontend Image
        uses: docker/build-push-action@v5
        with:
          context: ./frontend
          file: ./frontend/Dockerfile
          build-args: |
            VITE_API_URL=/api
          push: true
          tags: |
            ${{ steps.login-ecr.outputs.registry }}/${{ vars.ECR_REPOSITORY_FRONTEND || 'cpass-frontend' }}:${{ steps.set-tag.outputs.tag }}
            ${{ steps.login-ecr.outputs.registry }}/${{ vars.ECR_REPOSITORY_FRONTEND || 'cpass-frontend' }}:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max

  # ---------------------------------------------------------------------------
  # Stage 3: Secure Deployment to AWS EC2 via AWS Systems Manager (SSM)
  # ---------------------------------------------------------------------------
  deploy:
    name: Deploy to AWS EC2 via AWS Systems Manager
    needs: build-and-push
    runs-on: ubuntu-latest

    steps:
      - name: Configure AWS Credentials via GitHub OIDC
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_TO_ASSUME }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Dispatch Deployment Command via AWS SSM
        id: ssm-deploy
        env:
          EC2_INSTANCE_ID: ${{ vars.EC2_INSTANCE_ID }}
          APP_DIR: ${{ vars.APP_DIR || '/home/ubuntu/CPASS' }}
          REGISTRY: ${{ needs.build-and-push.outputs.registry }}
          TAG: ${{ needs.build-and-push.outputs.image_tag }}
          BACKEND_REPO: ${{ vars.ECR_REPOSITORY_BACKEND || 'cpass-backend' }}
          FRONTEND_REPO: ${{ vars.ECR_REPOSITORY_FRONTEND || 'cpass-frontend' }}
        run: |
          echo "Dispatching deployment to EC2 Instance: ${EC2_INSTANCE_ID}"
          
          COMMAND_ID=$(aws ssm send-command \
            --instance-ids "${EC2_INSTANCE_ID}" \
            --document-name "AWS-RunShellScript" \
            --comment "Deploy CPASS commit ${TAG} with automatic rollback" \
            --parameters commands="[
              \"set -e\",
              \"cd ${APP_DIR}\",
              \"aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${REGISTRY}\",
              \"echo 'Recording existing images for rollback safety...'\",
              \"PREV_BACKEND=\$(docker inspect --format='{{.Image}}' cpass-backend 2>/dev/null || echo '')\",
              \"PREV_FRONTEND=\$(docker inspect --format='{{.Image}}' cpass-frontend 2>/dev/null || echo '')\",
              \"echo 'Pulling new versioned images (${TAG})...'\",
              \"docker pull ${REGISTRY}/${BACKEND_REPO}:${TAG}\",
              \"docker pull ${REGISTRY}/${FRONTEND_REPO}:${TAG}\",
              \"docker tag ${REGISTRY}/${BACKEND_REPO}:${TAG} cpass-backend:latest\",
              \"docker tag ${REGISTRY}/${FRONTEND_REPO}:${TAG} cpass-frontend:latest\",
              \"echo 'Recreating containers with new images...'\",
              \"docker compose up -d --remove-orphans\",
              \"docker compose ps\",
              \"echo 'Waiting 15s for container health checks...'\",
              \"sleep 15\",
              \"if ! curl -fail http://localhost/api/health; then\",
              \"  echo 'DEPLOYMENT HEALTH CHECK FAILED! Initiating automatic rollback...'\",
              \"  if [ -n \\\"\$PREV_BACKEND\\\" ]; then docker tag \$PREV_BACKEND cpass-backend:latest; fi\",
              \"  if [ -n \\\"\$PREV_FRONTEND\\\" ]; then docker tag \$PREV_FRONTEND cpass-frontend:latest; fi\",
              \"  docker compose up -d --remove-orphans\",
              \"  echo 'Rollback to previous containers completed.'\",
              \"  exit 1\",
              \"fi\",
              \"echo 'Deployment successful and verified healthy for tag ${TAG}'\"
            ]" \
            --query "Command.CommandId" \
            --output text)
          
          echo "Command dispatched with ID: ${COMMAND_ID}"
          echo "command_id=${COMMAND_ID}" >> $GITHUB_OUTPUT

      - name: Monitor SSM Deployment Execution
        env:
          COMMAND_ID: ${{ steps.ssm-deploy.outputs.command_id }}
          EC2_INSTANCE_ID: ${{ vars.EC2_INSTANCE_ID }}
        run: |
          echo "Waiting for command ${COMMAND_ID} to finish on instance ${EC2_INSTANCE_ID}..."
          STATUS="InProgress"
          while [ "$STATUS" = "InProgress" ] || [ "$STATUS" = "Pending" ]; do
            sleep 5
            STATUS=$(aws ssm get-command-invocation \
              --command-id "${COMMAND_ID}" \
              --instance-id "${EC2_INSTANCE_ID}" \
              --query "Status" \
              --output text 2>/dev/null || echo "Pending")
            echo "Current status: ${STATUS}"
          done

          if [ "$STATUS" != "Success" ]; then
            echo "Deployment execution failed with status: ${STATUS}"
            aws ssm get-command-invocation \
              --command-id "${COMMAND_ID}" \
              --instance-id "${EC2_INSTANCE_ID}" \
              --query "StandardErrorContent" \
              --output text
            exit 1
          fi

          echo "Deployment completed successfully!"
          aws ssm get-command-invocation \
            --command-id "${COMMAND_ID}" \
            --instance-id "${EC2_INSTANCE_ID}" \
            --query "StandardOutputContent" \
            --output text
</file>

