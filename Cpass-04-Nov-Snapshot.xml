/* ==========================================================================
   CPASS L4 Business Leader (BL) Dashboard & Dossier Stylesheet
   ========================================================================== */

.l4-dashboard {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
  padding: 0.5rem 0 60px 0;
  box-sizing: border-box;
}

/* Header Panel */
.l4-header-panel {
  background: var(--card, #ffffff);
  border: 1px solid var(--line, #e2e8f0);
  border-radius: 14px;
  padding: 1.25rem 1.75rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1.25rem;
  box-shadow: 0 1px 4px rgba(15, 23, 42, 0.04);
}

.l4-header-title {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
  min-width: 300px;
}

.l4-header-title h2 {
  margin: 0;
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--ink, #0e1424);
  display: flex;
  align-items: center;
  gap: 12px;
  letter-spacing: -0.015em;
}

.l4-header-title p {
  margin: 0;
  font-size: 0.875rem;
  color: var(--mut, #64748b);
  line-height: 1.45;
  max-width: 780px;
}

.l4-badge-role {
  display: inline-flex;
  align-items: center;
  padding: 3px 10px;
  border-radius: 16px;
  font-size: 0.72rem;
  font-weight: 700;
  background: #fdf2f8;
  color: #9d174d;
  border: 1px solid #fbcfe8;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.l4-header-controls {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.l4-state-control {
  display: flex;
  align-items: center;
  gap: 10px;
}

.l4-state-control label {
  font-size: 0.85rem;
  font-weight: 600;
  color: #475569;
}

.l4-state-pill {
  background: #f1f5f9;
  border: 1px solid #cbd5e1;
  padding: 6px 14px;
  border-radius: 8px;
  font-size: 0.875rem;
  font-weight: 600;
  color: #1e293b;
}

.l4-select-input {
  height: 40px;
  padding: 0 14px;
  border-radius: 8px;
  border: 1px solid var(--line, #cbd5e1);
  background: #ffffff;
  color: var(--ink, #0e1424);
  font-size: 0.875rem;
  font-weight: 500;
  outline: none;
  cursor: pointer;
  min-width: 250px;
  box-sizing: border-box;
  transition: border-color 0.15s ease;
}

.l4-select-input:focus {
  border-color: #2563eb;
}

.l4-btn-refresh {
  height: 40px;
  padding: 0 16px;
  border-radius: 8px;
  border: 1px solid var(--line, #cbd5e1);
  background: #ffffff;
  color: #334155;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: all 0.15s ease;
}

.l4-btn-refresh:hover:not(:disabled) {
  background: #f8fafc;
  border-color: #94a3b8;
}

/* Metric Cards Grid */
.l4-metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 1rem;
}

.l4-metric-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 1.15rem 1.25rem;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 6px;
  transition: all 0.2s ease;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
}

.l4-metric-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(15, 23, 42, 0.06);
}

.l4-metric-card.active {
  border-color: #2563eb;
  background: #f8faff;
  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
}

.l4-card-title {
  font-size: 0.75rem;
  font-weight: 700;
  color: #64748b;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.l4-card-count {
  font-size: 1.85rem;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.1;
}

.l4-card-subtext {
  font-size: 0.78rem;
  color: #94a3b8;
}

.l4-metric-card.metric-pending .l4-card-count {
  color: #d97706;
}

.l4-metric-card.metric-approved .l4-card-count {
  color: #16a34a;
}

.l4-metric-card.metric-returned .l4-card-count {
  color: #ea580c;
}

.l4-metric-card.metric-rejected .l4-card-count {
  color: #dc2626;
}

/* Candidate Queue Table Panel */
.l4-table-panel {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  padding: 1.25rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  box-shadow: 0 1px 4px rgba(15, 23, 42, 0.04);
}

.l4-table-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
}

.l4-table-title-area {
  display: flex;
  align-items: center;
  gap: 12px;
}

.l4-table-title-area h3 {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 700;
  color: #0f172a;
}

.l4-queue-filter-pill {
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 0.78rem;
  padding: 3px 10px;
  border-radius: 12px;
  border: 1px solid #bfdbfe;
}

.l4-search-box {
  position: relative;
  min-width: 320px;
}

.l4-search-box input {
  width: 100%;
  height: 38px;
  padding: 0 32px 0 12px;
  border-radius: 8px;
  border: 1px solid #cbd5e1;
  font-size: 0.85rem;
  outline: none;
  box-sizing: border-box;
}

.l4-search-box input:focus {
  border-color: #2563eb;
}

.l4-search-clear {
  position: absolute;
  right: 8px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: #94a3b8;
  cursor: pointer;
  font-size: 14px;
}

.l4-table-responsive {
  width: 100%;
  overflow-x: auto;
}

.l4-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.85rem;
  text-align: left;
}

.l4-table th {
  background: #f8fafc;
  color: #475569;
  font-weight: 700;
  padding: 10px 12px;
  border-bottom: 2px solid #e2e8f0;
  white-space: nowrap;
}

.l4-table td {
  padding: 10px 12px;
  border-bottom: 1px solid #f1f5f9;
  color: #1e293b;
  vertical-align: middle;
}

.l4-table tr:hover {
  background: #f8fafc;
}

.l4-cand-name-cell {
  display: flex;
  flex-direction: column;
}

.cand-name {
  font-weight: 600;
  color: #0f172a;
}

.cand-sub {
  font-size: 0.75rem;
  color: #64748b;
}

.l4-btn-review {
  background: #2563eb;
  color: #ffffff;
  border: none;
  border-radius: 6px;
  padding: 6px 12px;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s ease;
  white-space: nowrap;
}

.l4-btn-review:hover {
  background: #1d4ed8;
}

/* Pagination */
.l4-pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 10px;
  font-size: 0.85rem;
  color: #64748b;
}

.l4-pagination-controls {
  display: flex;
  align-items: center;
  gap: 10px;
}

.l4-pagination-controls button {
  padding: 5px 12px;
  border-radius: 6px;
  border: 1px solid #cbd5e1;
  background: #ffffff;
  font-size: 0.8rem;
  font-weight: 500;
  cursor: pointer;
}

.l4-pagination-controls button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
