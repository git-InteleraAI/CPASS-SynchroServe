            "filter": norm_filter,
            "filter_type": norm_filter,
            "total_count": 0,
            "page": actual_page,
            "page_size": actual_page_size,
            "total_pages": 0,
            "candidates": [],
        }

    if norm_filter in {"received", "l2_received"} and not l2_received_in_state:
        return {
