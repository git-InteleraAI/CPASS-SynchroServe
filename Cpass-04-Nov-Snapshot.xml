# =============================================================================
def test_full_review_progression_l3_to_l4():
    """COPS verifies dossier and advances it to L4 BL; L4 then successfully approves."""
    # Step 1: L3 COPS Verifies
    app.dependency_overrides[get_current_user] = lambda: L3_USER

    cops_verified_audit = {
