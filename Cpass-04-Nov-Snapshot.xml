.l2-compact-card {
  background: #ffffff;
  border: 1px solid var(--line, #E2E8F0);
  border-radius: 14px;
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 8px;
  cursor: pointer;
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 1px 3px rgba(10, 42, 122, 0.04), 0 1px 2px rgba(10, 42, 122, 0.02);
  user-select: none;
  min-height: 84px;
  position: relative;
  overflow: hidden;
}

.l2-compact-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: transparent;
  transition: background 0.15s ease;
}

/* Card 1: Total - CPASS brand blue */
.l2-compact-card.total::before { background: #0B4FB8; }
/* Card 2: Received - Indigo */
.l2-compact-card.received::before { background: #4F46E5; }
/* Card 3: Recommended - Green */
.l2-compact-card.recommended::before { background: #16A34A; }
/* Card: Verified - Emerald/Teal (L3 COPS) */
.l2-compact-card.verified::before { background: #059669; }
/* Card: Approved - Green (L4 BL & L5 CEO) */
.l2-compact-card.approved::before { background: #16A34A; }
/* Card 4: Rejected - Red */
.l2-compact-card.rejected::before { background: #DC2626; }
/* Card 5: Pending - Amber */
.l2-compact-card.pending::before { background: #D97706; }

.l2-compact-card:hover {
  transform: translateY(-2px);
  border-color: #CBD5E1;
  box-shadow: 0 6px 16px -2px rgba(10, 42, 122, 0.08);
}

.l2-compact-card:focus-visible {
  outline: 2px solid #0B4FB8;
  outline-offset: 2px;
}

/* Card Active (Selected) State */
.l2-compact-card.active {
  border-color: #0B4FB8;
  background: #F8FAFC;
  box-shadow: 0 0 0 2px #0B4FB8, 0 6px 16px -2px rgba(11, 79, 184, 0.14);
}

.l2-compact-card.active::after {
  content: '';
  position: absolute;
  top: 10px;
  right: 10px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #0B4FB8;
}

.l2-compact-card-meta {
  display: flex;
  align-items: center;
  gap: 8px;
}

.l2-compact-card-icon {
  width: 26px;
  height: 26px;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.l2-compact-card.total .l2-compact-card-icon { background: #EFF6FF; color: #0B4FB8; }
.l2-compact-card.received .l2-compact-card-icon { background: #EEF2FF; color: #4F46E5; }
.l2-compact-card.recommended .l2-compact-card-icon { background: #F0FDF4; color: #16A34A; }
.l2-compact-card.verified .l2-compact-card-icon { background: #ECFDF5; color: #059669; }
.l2-compact-card.approved .l2-compact-card-icon { background: #F0FDF4; color: #16A34A; }
.l2-compact-card.rejected .l2-compact-card-icon { background: #FEF2F2; color: #DC2626; }
.l2-compact-card.pending .l2-compact-card-icon { background: #FFFBEB; color: #D97706; }

.l2-compact-card-title {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: #64748B;
}

.l2-compact-card-count {
  font-family: 'Inter Tight', 'Inter', -apple-system, sans-serif;
  font-size: 24px;
  font-weight: 800;
  color: #0E1424;
  line-height: 1.1;
  letter-spacing: -0.025em;
}

.l2-compact-card.total .l2-compact-card-count { color: #0E1424; }
.l2-compact-card.received .l2-compact-card-count { color: #4338CA; }
.l2-compact-card.recommended .l2-compact-card-count { color: #15803D; }
.l2-compact-card.verified .l2-compact-card-count { color: #047857; }
.l2-compact-card.approved .l2-compact-card-count { color: #15803D; }
.l2-compact-card.rejected .l2-compact-card-count { color: #DC2626; }
.l2-compact-card.pending .l2-compact-card-count { color: #B45309; }

