                "bank_name": None,
            })
        if len(new_sals) >= 3:
            sal_list = new_sals
        elif new_sals:
            sal_list = new_sals
            while len(sal_list) < 3:
                last_m = sal_list[-1]["month"]
                last_y = sal_list[-1]["year"]
                next_m = last_m + 1
                next_y = last_y
                if next_m > 12:
                    next_m = 1
                    next_y += 1
                sal_list.append({
                    "id": f"sal_{len(sal_list) + 1}",
                    "employer_id": sal_list[-1]["employer_id"],
                    "month": next_m,
                    "year": next_y,
                    "working_days": 26,
                    "pay_days": 26,
