/* ==========================================================================
   CPASS — SynchroServe Unified Design System & Application Styles
   ========================================================================== */

:root {
  /* Brand Palette */
  --bg: #F3F6FB;
  --card: #FFFFFF;
  --ink: #0E1424;
  --mut: #5E6478;
  --line: #E4E8F1;
  --blue: #0B4FB8;
  --blue-hover: #1C6BEA;
  --navy: #0A2A7A;
  --red: #F4000F;
  --mag: #B0146A;
  --soft: #EEF3FC;

  /* Semantic Feedback Tokens */
  --ok: #0F8A4B;
  --okbg: #E4F5EC;
  --warn: #B35A00;
  --warnbg: #FFF1E0;
  --danger: #C5221F;
  --dangerbg: #FCE8E6;

  /* Backward Compatibility Aliases */
  --accent: var(--blue);
  --accent-ink: #FFFFFF;
  --muted: var(--mut);
  --paper: var(--bg);

  color-scheme: light;
}

/* CPASS is strictly a light-theme enterprise application. Automatic OS dark mode is disabled. */
html, :root {
  color-scheme: light !important;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: env(safe-area-inset-top, 0px);
}

body {
  margin: 0;
  font: 400 15px/1.5 'Inter', system-ui, -apple-system, sans-serif;
  color: var(--ink);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}

h1, h2, h3, h4, h5, h6 {
  font-family: 'Inter Tight', 'Inter', sans-serif;
  color: var(--ink);
  margin: 0 0 0.5rem;
  letter-spacing: -0.025em;
  font-weight: 700;
}

button, select, input, textarea {
  font: inherit;
  color: inherit;
}

:focus-visible {
  outline: 3px solid var(--blue);
  outline-offset: 2px;
}

/* ==========================================================================
   Application Shell & Navigation Header
   ========================================================================== */

.app-layout {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.top {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px clamp(16px, 4vw, 40px);
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line);
  box-shadow: 0 2px 12px rgba(10, 42, 122, 0.04);
}

.top .logo {
  height: 36px;
  width: auto;
  display: block;
  object-fit: contain;
}

.user {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 14px;
}

.av {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--blue), var(--mag));
  color: #fff;
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 13px;
  letter-spacing: 0.02em;
  flex-shrink: 0;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-info b {
  font-weight: 600;
  color: var(--ink);
  line-height: 1.25;
}

.user-info small {
  color: var(--mut);
  font-size: 12px;
  line-height: 1.2;
}

.link {
  background: none;
  border: 1.5px solid var(--line);
  border-radius: 99px;
  padding: 7px 16px;
  cursor: pointer;
  font-weight: 600;
  font-size: 13px;
  color: var(--ink);
  transition: all 0.2s ease;
}

.link:hover {
  border-color: var(--red);
  color: var(--red);
  background: rgba(244, 0, 15, 0.04);
}

@media (max-width: 640px) {
  .top {
    padding: 10px 14px;
    gap: 10px;
  }
  .top .logo {
    height: 36px;
  }
  .user {
    gap: 8px;
  }
  .user-info small {
    display: none;
  }
  .link {
    padding: 5px 12px;
    font-size: 12px;
  }
}

.content-container {
  max-width: 1240px;
  width: 100%;
  margin: 0 auto;
  padding: clamp(16px, 3vw, 32px) clamp(16px, 3.5vw, 36px) 56px;
  flex: 1;
}

/* Allow L3 COPS dashboard to utilize up to 1440px wide desktop screens */
.content-container:has(.l3-dashboard) {
  max-width: 1440px;
  padding-left: clamp(16px, 2.5vw, 32px);
  padding-right: clamp(16px, 2.5vw, 32px);
}

/* ==========================================================================
   Hero Banners & Visual Accents
   ========================================================================== */

.hero-banner {
  border-radius: 26px;
  padding: clamp(22px, 3.5vw, 36px);
  color: #fff;
  background: radial-gradient(500px 260px at 90% 120%, rgba(244, 0, 15, 0.45), transparent 70%),
              linear-gradient(120deg, #0A2A7A, #0B4FB8 70%);
  display: flex;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  align-items: flex-end;
  margin-bottom: 24px;
  box-shadow: 0 12px 30px -10px rgba(10, 42, 122, 0.35);
}

.hero-banner h2 {
  font: 700 clamp(24px, 3.4vw, 36px)/1.1 'Inter Tight', sans-serif;
  letter-spacing: -0.03em;
  margin: 8px 0 0;
  color: #fff;
}

.hero-banner p {
  margin: 6px 0 0;
  color: rgba(255, 255, 255, 0.88);
  font-size: clamp(13px, 1.6vw, 15px);
  max-width: 60ch;
}

.pill-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 99px;
  padding: 5px 14px;
  font-size: 13px;
  font-weight: 600;
  color: #fff;
  backdrop-filter: blur(8px);
}

/* ==========================================================================
   Panels, Cards & Content Sections
   ========================================================================== */

.panel {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: clamp(18px, 2.5vw, 26px);
  box-shadow: 0 4px 20px rgba(10, 42, 122, 0.04);
}

/* Candidate Highlights Card */
.cand-card {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
  align-items: center;
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 18px 22px;
  margin-bottom: 20px;
  box-shadow: 0 4px 16px rgba(10, 42, 122, 0.03);
}

.cand-card h3 {
  margin: 0;
  font-size: 21px;
}

.cand-card p {
  margin: 3px 0 0;
  color: var(--mut);
  font-size: 13.5px;
}

/* Document Work Sections */
.doc-section {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: clamp(18px, 2.5vw, 24px);
  margin-bottom: 22px;
  box-shadow: 0 4px 16px rgba(10, 42, 122, 0.03);
}

.doc-section-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  align-items: flex-start;
  margin-bottom: 16px;
}

.doc-section-header h3 {
  margin: 0;
  font-size: 19px;
}

.doc-section-header p {
  margin: 2px 0 0;
  color: var(--mut);
  font-size: 13px;
}

/* Document Item Cards */
.doc-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  border: 1px solid var(--line);
  border-left: 4px solid var(--ok);
  border-radius: 14px;
  padding: 14px 18px;
  margin-bottom: 12px;
  background: var(--card);
  transition: border-color 0.2s, box-shadow 0.2s;
}

.doc-card.staged {
  border-left: 4px solid var(--blue);
  background: var(--soft);
}

.doc-card.replacing {
  border-left: 4px solid #F59E0B;
  background: #FFFDF9;
}

.doc-card b {
  display: block;
  font-weight: 600;
  color: var(--ink);
  font-size: 14.5px;
}

.doc-card small {
  color: var(--mut);
  word-break: break-all;
  font-size: 12.5px;
}

/* Slot & Row Builders */
.slots-container {
  margin-top: 18px;
}

.slots-container h4 {
  margin: 0 0 10px;
  font-size: 13px;
  color: var(--mut);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.slot-row {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 12px;
  align-items: center;
  background: var(--soft);
  border-radius: 14px;
  padding: 12px 14px;
  margin-bottom: 10px;
  border: 1px solid rgba(11, 79, 184, 0.08);
}

.period-picker {
  display: flex;
  gap: 8px;
}

.file-picker-box {
  display: flex;
  gap: 10px;
  align-items: center;
  min-width: 0;
}

.file-picker-box span {
  font-size: 13px;
  color: var(--mut);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Checklist Panel */
.checklist-card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: 22px;
  box-shadow: 0 4px 16px rgba(10, 42, 122, 0.03);
}

.checklist-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 14px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--line);
}

.checklist-header h3 {
  margin: 0;
  font-size: 18px;
}

.checklist-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  padding: 12px 0;
  border-top: 1px solid var(--line);
  font-size: 14px;
}

.checklist-item:first-of-type {
  border-top: none;
}

/* ==========================================================================
   Form Controls, Inputs & Selectors
   ========================================================================== */

.filters {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: 20px;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 14px;
  box-shadow: 0 14px 34px -20px rgba(10, 42, 122, 0.35);
  margin-bottom: 24px;
}

.filters label,
.grid label,
label {
  display: grid;
  gap: 6px;
  font-size: 13px;
  color: var(--mut);
  font-weight: 600;
  min-width: 0;
}

.sel,
select,
input[type="text"],
input[type="email"],
input[type="password"] {
  height: 44px;
  border-radius: 12px;
  border: 1.5px solid var(--line);
  background: var(--card);
  padding: 0 12px;
  width: 100%;
  min-width: 0;
  font-size: 14px;
  color: var(--ink);
  transition: border-color 0.2s, box-shadow 0.2s;
}

.sel:focus,
select:focus,
input:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(11, 79, 184, 0.14);
  outline: 0;
}

select:disabled,
input:disabled {
  background: var(--soft);
  color: var(--mut);
  cursor: not-allowed;
  opacity: 0.75;
}

.grid {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  margin: 1rem 0;
}

/* ==========================================================================
   Buttons, Badges & Chips
   ========================================================================== */

.btn {
  height: 48px;
  border: 0;
  border-radius: 99px;
  background: linear-gradient(100deg, var(--blue), #1C6BEA);
  color: #fff;
  font-weight: 600;
  font-size: 14.5px;
  cursor: pointer;
  padding: 0 24px;
  transition: transform 0.2s, box-shadow 0.2s;
  box-shadow: 0 10px 24px -10px rgba(11, 79, 184, 0.65);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
}

.btn:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 12px 28px -8px rgba(11, 79, 184, 0.8);
}

.btn:active:not(:disabled) {
  transform: scale(0.98);
}

.btn:disabled {
  opacity: 0.65;
  cursor: not-allowed;
  box-shadow: none;
}

.btn-secondary,
.sm {
  border: 1.5px solid var(--line);
  background: var(--card);
  border-radius: 99px;
  padding: 7px 16px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  color: var(--ink);
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary:hover,
.sm:hover {
  border-color: var(--blue);
  color: var(--blue);
  background: rgba(11, 79, 184, 0.04);
}

.btn-danger {
  border: 1.5px solid rgba(244, 0, 15, 0.2);
  background: rgba(244, 0, 15, 0.05);
  color: var(--danger);
  border-radius: 99px;
  padding: 7px 16px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-danger:hover {
  background: var(--danger);
  color: #fff;
  border-color: var(--danger);
}

.btn-outline {
  border: 1.5px solid var(--blue);
  background: transparent;
  color: var(--blue);
  border-radius: 99px;
  padding: 7px 16px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
}

.btn-outline:hover {
  background: rgba(11, 79, 184, 0.06);
}

/* Badges and Chips */
.chip,
.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  border-radius: 99px;
  padding: 4px 12px;
  font-size: 12px;
  font-weight: 600;
  background: var(--okbg);
  color: var(--ok);
  white-space: nowrap;
  text-transform: none;
  letter-spacing: normal;
  border: none;
}

.chip.warn,
.badge-warning {
  background: var(--warnbg);
  color: var(--warn);
}

.chip.danger,
.badge-danger {
  background: var(--dangerbg);
  color: var(--danger);
}

.chip.info,
.badge-info {
  background: var(--soft);
  color: var(--blue);
}

.chip.staged,
