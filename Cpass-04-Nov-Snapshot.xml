runTest('7. CEO Rejected — displays Rejected, preserves prior stage signoffs', () => {
  const statement = {
    cpass_status: 'L5_REJECTED',
    audit_status: 'REJECTED',
    review_stages: {
      ch: { status: 'Recommended' },
      cops: { status: 'Verified' },
      bl: { status: 'Approved' },
