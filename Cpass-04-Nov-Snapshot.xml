}

.l1-search-clear-btn {
  background: none;
  border: none;
  color: #94A3B8;
  font-size: 13px;
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  transition: color 0.15s ease;
}

.l1-search-clear-btn:hover {
  color: #0E1424;
}

.l1-search-clear-btn:focus-visible {
  outline: 2px solid #0B4FB8;
  outline-offset: 1px;
}

.l1-cand-popup-search-btn,
.l1-btn-primary {
  height: 40px;
  box-sizing: border-box;
  background: #0B4FB8;
  color: #ffffff;
  border: 1px solid #0B4FB8;
  border-radius: 8px;
  padding: 0 20px;
  font-size: 13.5px;
  font-weight: 600;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  transition: all 0.15s ease;
  box-shadow: 0 1px 2px rgba(11, 79, 184, 0.15);
}

.l1-cand-popup-search-btn:hover,
.l1-btn-primary:hover {
  background: #0A2A7A;
  border-color: #0A2A7A;
  box-shadow: 0 3px 8px rgba(11, 79, 184, 0.25);
  transform: translateY(-1px);
}

.l1-cand-popup-search-btn:active,
.l1-btn-primary:active {
  transform: translateY(0);
}

.l1-cand-popup-search-btn:focus-visible,
.l1-btn-primary:focus-visible {
  outline: 2px solid #0B4FB8;
  outline-offset: 2px;
}

.l1-cand-popup-body {
  flex: 1;
  min-height: 220px;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.l1-popup-table-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  width: 100%;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.l1-popup-table-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.l1-cand-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  font-size: 13px;
}

.l1-cand-table th {
  position: sticky;
  top: 0;
  background: #F8FAFC;
  color: #475569;
  font-weight: 700;
  text-align: left;
  padding: 11px 14px;
  border-bottom: 2px solid #CBD5E1;
  font-size: 11.5px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  z-index: 10;
  box-shadow: 0 1px 0 #CBD5E1;
  white-space: nowrap;
}

.l1-cand-table td {
  padding: 10px 14px;
  border-bottom: 1px solid #F1F5F9;
  color: #1E293B;
  vertical-align: middle;
}

.l1-cand-table tbody tr:hover td {
