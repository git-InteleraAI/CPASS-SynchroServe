  white-space: nowrap;
}

.l1-status-pill.approved,
.l1-status-pill.success {
  background: #DCFCE7;
  color: #166534;
  border: 1px solid #BBF7D0;
}

.l1-status-pill.rejected,
.l1-status-pill.danger {
