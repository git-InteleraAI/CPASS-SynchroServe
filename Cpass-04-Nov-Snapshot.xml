/* ==========================================================================
   CPASS L1 Coordinator Dashboard Styles — Premium Enterprise Design System
   Matches Login Theme: Clean, Minimalist, Refined, Accessible, Responsive
   ========================================================================== */

.l1-dashboard {
  display: flex;
  flex-direction: column;
  gap: 1.75rem;
  width: 100%;
  padding-bottom: 48px; /* Normal document flow padding (reserved fixed bar space removed) */
}

/* --------------------------------------------------------------------------
   Candidate Selection Stepper Toolbar
   -------------------------------------------------------------------------- */
.l1-selector-panel {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: clamp(16px, 2vw, 22px);
  box-shadow: 0 4px 20px rgba(10, 42, 122, 0.04);
}

.l1-selector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--line);
  flex-wrap: wrap;
  gap: 0.5rem;
}

.l1-selector-header h3 {
  margin: 0;
  font-size: 16px;
  font-weight: 700;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 8px;
}

.l1-step-indicator {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--soft);
  color: var(--blue);
  font-size: 12px;
  font-weight: 700;
}

.l1-selector-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 12px;
}

@media (min-width: 1100px) {
  .l1-selector-grid {
    grid-template-columns: 1.1fr 1.3fr 1.2fr 1.1fr 1.6fr;
  }
}

.l1-select-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.l1-select-label {
  font-size: 12px;
  font-weight: 600;
  color: var(--mut);
  display: flex;
  align-items: center;
  gap: 6px;
}

.l1-step-dot {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--soft);
  color: var(--blue);
  display: inline-grid;
  place-items: center;
  font-size: 10px;
  font-weight: 700;
}

.l1-select-wrapper {
  position: relative;
  width: 100%;
}

.l1-select-wrapper select {
  width: 100%;
  height: 44px;
  background: var(--card);
  border: 1.5px solid var(--line);
  border-radius: 12px;
  padding: 0 34px 0 12px;
  font-size: 13.5px;
  color: var(--ink);
  font-weight: 500;
  appearance: none;
  -webkit-appearance: none;
  cursor: pointer;
  transition: all 0.2s ease;
  outline: none;
}

.l1-select-wrapper select:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(11, 79, 184, 0.12);
}

.l1-select-wrapper select:disabled {
  background: #F8FAFC;
  color: #94A3B8;
  cursor: not-allowed;
  border-color: #E2E8F0;
}

.l1-select-icon {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  color: var(--mut);
  font-size: 12px;
}

/* --------------------------------------------------------------------------
   Candidate Details & Batch Cards Grid
   -------------------------------------------------------------------------- */
.l1-dossier-batch-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
  gap: 16px;
  margin-bottom: 20px;
}

.l1-cand-summary-card {
  background: var(--card);
  border: 1.5px solid var(--line);
  border-radius: 20px;
  padding: clamp(18px, 2.5vw, 24px);
  box-shadow: 0 4px 20px rgba(10, 42, 122, 0.04);
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.l1-cand-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.l1-cand-identity {
  display: flex;
  align-items: center;
  gap: 16px;
}

.l1-cand-avatar {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  background: linear-gradient(135deg, #0B4FB8 0%, #B0146A 100%);
  color: #ffffff;
  display: grid;
  place-items: center;
  font-size: 19px;
  font-weight: 700;
  letter-spacing: 0.02em;
  flex-shrink: 0;
  box-shadow: 0 6px 16px rgba(11, 79, 184, 0.25);
}

.l1-cand-names h2 {
  font-size: clamp(18px, 2.2vw, 22px);
  font-weight: 700;
  color: var(--ink);
  margin: 0 0 2px 0;
}

.l1-cand-id-badge {
  font-size: 13px;
  color: var(--mut);
  font-weight: 500;
}

.l1-status-pill {
  padding: 6px 14px;
  border-radius: 99px;
  font-size: 13px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.l1-status-pill.success {
  background: var(--okbg);
  color: var(--ok);
  border: 1px solid rgba(15, 138, 75, 0.2);
}

.l1-status-pill.info {
  background: var(--soft);
  color: var(--blue);
  border: 1px solid rgba(11, 79, 184, 0.18);
}

.l1-status-pill.warning {
  background: var(--warnbg);
  color: var(--warn);
  border: 1px solid rgba(179, 90, 0, 0.2);
}

.l1-status-pill.danger {
  background: var(--dangerbg);
  color: var(--danger);
  border: 1px solid rgba(197, 34, 31, 0.2);
}

.l1-cand-meta-grid {
  display: grid;
  grid-template-columns: repeat(4, 2fr);
  gap: 12px;
  background: var(--soft);
  border-radius: 14px;
  padding: 14px 18px;
  border: 1px solid rgba(11, 79, 184, 0.08);
}

.l1-meta-item {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.l1-meta-label {
  font-size: 11.5px;
  color: var(--mut);
  text-transform: uppercase;
  font-weight: 600;
  letter-spacing: 0.03em;
}

.l1-meta-val {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--ink);
}

/* Warnings and Blocking Hold Banners */
.l1-banner-warning {
  background: #FFFBEB;
  border: 1px solid #FCD34D;
  border-left: 4px solid #F59E0B;
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 13.5px;
  color: #92400E;
  display: flex;
  gap: 10px;
  align-items: flex-start;
}

.l1-banner-danger {
  background: #FEF2F2;
  border: 1px solid #FECACA;
  border-left: 4px solid #EF4444;
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 13.5px;
  color: #991B1B;
  display: flex;
  gap: 10px;
  align-items: flex-start;
}



/* --------------------------------------------------------------------------
   Document Workspaces (Sections 1, 2, 3)
   -------------------------------------------------------------------------- */
.l1-doc-workspace {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: clamp(18px, 2.5vw, 24px);
  box-shadow: 0 4px 20px rgba(10, 42, 122, 0.04);
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.l1-workspace-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 12px;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--line);
}

.l1-workspace-title-box {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  flex: 1;
  min-width: 240px;
}

.l1-step-badge {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--blue), var(--navy));
  color: #ffffff;
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 14px;
  flex-shrink: 0;
  margin-top: 2px;
}

.l1-workspace-title-box h3 {
  margin: 0;
  font-size: 17.5px;
  font-weight: 700;
  color: var(--ink);
}

.l1-workspace-title-box p {
  margin: 3px 0 0 0;
  font-size: 13px;
  color: var(--mut);
  line-height: 1.45;
}

/* --------------------------------------------------------------------------
   Document Workspace Counter Badge (Persisted / Staged Status Indicator)
   Clean, compact pill with subtle border and clear typography separation
   -------------------------------------------------------------------------- */
.l1-doc-counter-badge {
  display: inline-flex;
  align-items: center;
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 99px;
  padding: 4px 12px;
  gap: 10px;
  box-shadow: 0 1px 2px rgba(10, 42, 122, 0.03);
  user-select: none;
  flex-shrink: 0;
  align-self: flex-start;
  transition: all 0.15s ease;
}

.l1-counter-segment {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  line-height: 1;
}

.l1-counter-dot {
  font-size: 8px;
  line-height: 1;
}

.l1-counter-dot.persisted {
  color: #16A34A; /* Emerald green dot for confirmed persisted files */
}

.l1-counter-dot.staged {
  color: #0284C7; /* Sky blue dot for staged files pending submission */
}

.l1-counter-dot.empty {
  color: #94A3B8; /* Subtle neutral dot when count is 0 */
}

.l1-counter-count {
  font-family: 'Inter Tight', 'Inter', -apple-system, sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: #0B4FB8; /* Restrained CPASS brand blue for metrics */
}

.l1-counter-label {
  font-size: 12px;
  font-weight: 500;
  color: #64748B;
  letter-spacing: 0.01em;
}

.l1-counter-divider {
  width: 1px;
  height: 12px;
  background: #CBD5E1;
  flex-shrink: 0;
}

/* Document Item Cards */
.l1-doc-item-card {
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 16px;
  background: var(--card);
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: all 0.2s ease;
}

.l1-doc-item-card.persisted {
  border-left: 4px solid var(--ok);
  background: #FCFDFD;
}

.l1-doc-item-card.replacing {
  border-left: 4px solid #F59E0B;
  background: #FFFDF9;
}

.l1-doc-item-card.staged {
  border-left: 4px solid var(--blue);
  background: #F8FAFF;
}

.l1-doc-item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

.l1-file-info {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.l1-file-icon-box {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: var(--soft);
  color: var(--blue);
  display: grid;
  place-items: center;
  font-size: 16px;
  flex-shrink: 0;
}

.l1-file-details {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.l1-file-details .title {
  font-weight: 600;
  font-size: 14px;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.l1-file-details .meta {
  font-size: 12px;
  color: var(--mut);
}

.l1-btn-group {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
}

/* --------------------------------------------------------------------------
   Custom Accessible File Upload Control
   -------------------------------------------------------------------------- */
.l1-upload-zone {
  border: 1.5px dashed #CBD5E1;
  border-radius: 14px;
  padding: 14px 18px;
  background: #F8FAFC;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  transition: all 0.2s ease;
  position: relative;
  outline: none;
}

.l1-upload-zone:hover {
  border-color: var(--blue);
  background: #F0F7FF;
}

.l1-upload-zone:focus-visible {
  border-color: var(--blue);
  outline: 3px solid rgba(11, 79, 184, 0.2);
}

.l1-upload-zone.dragover {
  border-color: var(--blue);
  background: #E8F2FF;
  border-style: solid;
}

.l1-upload-prompt {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.l1-upload-icon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #E2E8F0;
  color: #475569;
  display: grid;
  place-items: center;
  font-size: 16px;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.l1-upload-zone:hover .l1-upload-icon {
  background: #DBEAFE;
  color: var(--blue);
}

.l1-upload-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.l1-upload-text .main {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--ink);
}

.l1-upload-text .hint {
  font-size: 11.5px;
  color: var(--mut);
}

.l1-btn-choose {
  background: #ffffff;
  border: 1.5px solid var(--line);
  border-radius: 99px;
  padding: 6px 16px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--ink);
  cursor: pointer;
  white-space: nowrap;
  pointer-events: auto;
  transition: all 0.2s ease;
}

.l1-upload-zone:hover .l1-btn-choose {
  border-color: var(--blue);
  color: var(--blue);
}

/* Staged File Card */
.l1-staged-file-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  background: #ffffff;
  border: 1px solid #BFDBFE;
  border-radius: 12px;
  padding: 10px 14px;
}

/* --------------------------------------------------------------------------
   Monthly Slots (Salary / Bank)
   -------------------------------------------------------------------------- */
.l1-slot-row {
  background: #F8FAFC;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 12px;
  transition: all 0.2s ease;
}

.l1-slot-row.staged {
  background: #F0F7FF;
  border-color: #BFDBFE;
}

.l1-slot-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}

.l1-slot-badge {
  font-size: 12.5px;
  font-weight: 700;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 6px;
}

.l1-slot-controls {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 12px;
  align-items: center;
}

@media (max-width: 768px) {
  .l1-slot-controls {
    grid-template-columns: 1fr;
  }
}

.l1-period-picker {
  display: flex;
  gap: 6px;
}

.l1-period-picker select {
  height: 40px;
  border: 1.5px solid var(--line);
  border-radius: 10px;
  padding: 0 8px;
  font-size: 13px;
  font-weight: 600;
  background: #ffffff;
  color: var(--ink);
  outline: none;
}

.l1-period-picker select:focus {
  border-color: var(--blue);
}

.l1-btn-add-slot {
  background: #ffffff;
  border: 1.5px dashed var(--line);
  border-radius: 12px;
  padding: 10px 18px;
  font-size: 13.5px;
  font-weight: 600;
  color: var(--blue);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  justify-content: center;
  transition: all 0.2s ease;
  margin-top: 4px;
}

.l1-btn-add-slot:hover {
  background: var(--soft);
  border-color: var(--blue);
}

/* --------------------------------------------------------------------------
   Action Buttons & Pills
   -------------------------------------------------------------------------- */
.l1-btn-secondary {
  background: #ffffff;
  border: 1.5px solid var(--line);
  border-radius: 99px;
  padding: 6px 14px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--ink);
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.l1-btn-secondary:hover {
  border-color: var(--blue);
  color: var(--blue);
  background: var(--soft);
}

.l1-btn-outline {
  background: transparent;
  border: 1.5px solid var(--line);
  border-radius: 99px;
  padding: 6px 14px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--ink);
  cursor: pointer;
  transition: all 0.2s ease;
}

.l1-btn-outline:hover {
  border-color: var(--blue);
  color: var(--blue);
}

.l1-btn-danger-ghost {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 99px;
  padding: 5px 12px;
  font-size: 12px;
  font-weight: 600;
  color: var(--danger);
  cursor: pointer;
  transition: all 0.2s ease;
}

.l1-btn-danger-ghost:hover {
  background: #FEE2E2;
  border-color: #FECACA;
}

/* --------------------------------------------------------------------------
   Placement Audit Statement Workflow Dock (Normal Document Flow)
   Placed at the end of the candidate workspace content - Not fixed/sticky
   -------------------------------------------------------------------------- */
.l1-submit-dock {
  position: static;
  background: var(--card, #ffffff);
  border: 1px solid var(--line, #E2E8F0);
  border-radius: 18px;
  box-shadow: 0 4px 20px rgba(10, 42, 122, 0.04);
  padding: clamp(16px, 2.5vw, 24px);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1.25rem;
  margin: 10px 0 0;
  width: 100%;
  box-sizing: border-box;
}

.l1-dock-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
  min-width: 260px;
}

.l1-dock-title {
  font-size: 15.5px;
  font-weight: 700;
  color: var(--ink, #0E1424);
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.l1-dock-desc {
  font-size: 13px;
  color: var(--mut, #5E6478);
  margin: 0;
  line-height: 1.45;
}

.l1-dock-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.l1-btn-primary-action {
  background: linear-gradient(135deg, #0B4FB8 0%, #0A2A7A 100%);
  color: #ffffff;
  border: none;
  border-radius: 99px;
  padding: 12px 28px;
  font-size: 14.5px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 6px 18px rgba(11, 79, 184, 0.3);
  transition: all 0.2s ease;
}

.l1-btn-primary-action:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 8px 24px rgba(11, 79, 184, 0.4);
}

.l1-btn-primary-action:disabled {
  background: #CBD5E1;
  color: #64748B;
  cursor: not-allowed;
  box-shadow: none;
  transform: none;
}

/* --------------------------------------------------------------------------
   Review & Success Modals
   -------------------------------------------------------------------------- */
.l1-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(10, 20, 45, 0.6);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: grid;
  place-items: center;
  padding: 16px;
  overflow-y: auto;
}

.l1-modal-card {
  background: #ffffff;
  border-radius: 24px;
  width: min(620px, 100%);
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 24px 60px -15px rgba(10, 42, 122, 0.35);
  border: 1px solid var(--line);
  overflow: hidden;
  animation: l1ModalFade 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
}

@keyframes l1ModalFade {
  from {
    opacity: 0;
    transform: scale(0.96) translateY(12px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.l1-modal-header {
  padding: 20px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--line);
}

.l1-modal-header h3 {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
  color: var(--ink);
}

.l1-modal-close-btn {
  background: none;
  border: none;
  font-size: 18px;
  color: var(--mut);
  cursor: pointer;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  transition: all 0.2s ease;
}

.l1-modal-close-btn:hover {
  background: var(--soft);
  color: var(--ink);
}

.l1-modal-body {
  padding: 24px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.l1-modal-footer {
  padding: 18px 24px;
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  background: #F8FAFC;
}

/* --------------------------------------------------------------------------
   Empty / Idle Workspace Guidance
   -------------------------------------------------------------------------- */
.l1-empty-state {
  background: var(--card);
  border: 1px dashed var(--line);
  border-radius: 20px;
  padding: clamp(36px, 6vw, 64px) 24px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  color: var(--mut);
}

.l1-empty-icon {
  width: 64px;
  height: 64px;
  border-radius: 20px;
  background: var(--soft);
  color: var(--blue);
  display: grid;
  place-items: center;
  font-size: 28px;
  margin-bottom: 4px;
}

.l1-empty-state h3 {
  margin: 0;
  color: var(--ink);
  font-size: 19px;
  font-weight: 700;
}

.l1-empty-state p {
  margin: 0;
  font-size: 14px;
  max-width: 46ch;
  line-height: 1.5;
}

/* ==========================================================================
   Placement Audit Workflow & Form Sections
   ========================================================================== */
.l1-staging-sync-dock {
  background: linear-gradient(135deg, rgba(2, 132, 199, 0.04) 0%, rgba(11, 79, 184, 0.06) 100%);
  border: 1.5px dashed rgba(11, 79, 184, 0.25);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  padding: 18px 24px;
}

/* --------------------------------------------------------------------------
   Audit Header Actions Bar
   -------------------------------------------------------------------------- */
.l1-audit-actions-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 16px 20px;
  box-shadow: 0 4px 16px -6px rgba(10, 42, 122, 0.08);
}

.l1-audit-status-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: 99px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.l1-audit-status-badge.draft {
  background: #EFF6FF;
  color: #1D4ED8;
  border: 1px solid #BFDBFE;
}

.l1-audit-status-badge.submitted {
  background: #F0FDF4;
  color: #15803D;
  border: 1px solid #BBF7D0;
}

.l1-audit-status-badge.rejected {
  background: #FEE2E2;
  color: #B91C1C;
  border: 1px solid #FECACA;
}

/* Rejection Notice Banner in Dossier */
.l1-rejection-banner {
  background: #FEF2F2;
  border: 1.5px solid #FECACA;
  border-radius: 16px;
  padding: 16px 20px;
  box-shadow: 0 4px 14px -4px rgba(220, 38, 38, 0.12);
}

.l1-rejection-banner-content {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

.l1-rejection-icon {
  font-size: 24px;
  flex-shrink: 0;
  line-height: 1.2;
}

.l1-rejection-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  font-size: 15px;
  color: #991B1B;
}

.l1-rejection-desc {
  font-size: 13.5px;
  color: #B91C1C;
  margin-top: 4px;
  line-height: 1.45;
}

.l1-rejection-reason {
  margin-top: 8px;
  padding: 9px 13px;
  background: #FFFFFF;
  border: 1px solid #FCA5A5;
  border-radius: 8px;
  font-size: 13.5px;
  color: #7F1D1D;
  line-height: 1.45;
}

.l1-rejection-remarks {
  margin-top: 6px;
  padding: 8px 12px;
  background: #FFF5F5;
  border: 1px solid #FED7D7;
  border-radius: 8px;
  font-size: 13px;
  color: #9B2C2C;
}

.l1-rejection-meta {
  font-size: 12.5px;
  color: #991B1B;
  margin-top: 8px;
}

.l1-audit-btn-group {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}

/* --------------------------------------------------------------------------
   Audit Tables & Grids
   -------------------------------------------------------------------------- */
.l1-audit-card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 22px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-shadow: 0 4px 18px -6px rgba(10, 42, 122, 0.06);
}

.l1-audit-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  border-bottom: 1px solid var(--line);
  padding-bottom: 14px;
}

.l1-audit-card-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.l1-audit-card-title h3 {
  margin: 0;
  font-size: 17.5px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.01em;
}

.l1-audit-card-title p {
  margin: 2px 0 0;
  font-size: 13px;
  color: var(--mut);
}

.l1-table-responsive {
  width: 100%;
  overflow-x: auto;
  border-radius: 12px;
  border: 1px solid var(--line);
}

.l1-audit-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  text-align: left;
}

.l1-audit-table th {
  background: #F8FAFC;
  color: var(--mut);
  font-weight: 600;
  padding: 10px 12px;
  border-bottom: 1px solid var(--line);
  white-space: nowrap;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.l1-audit-table td {
  padding: 8px 10px;
  border-bottom: 1px solid var(--line);
  vertical-align: middle;
}

.l1-audit-table tr:last-child td {
  border-bottom: none;
}

.l1-audit-table input,
.l1-audit-table select {
  width: 100%;
  height: 38px;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 0 10px;
  font-size: 13px;
  background: #ffffff;
  color: var(--ink);
  transition: border-color 0.2s ease;
}

.l1-audit-table input:focus,
.l1-audit-table select:focus {
  border-color: var(--blue);
  outline: none;
  box-shadow: 0 0 0 3px rgba(11, 79, 184, 0.1);
}

.l1-audit-table input[type="number"] {
  text-align: right;
  font-family: monospace;
  font-size: 13px;
}

/* --------------------------------------------------------------------------
   Section 3: Monthly Salary Disbursement Record (Six-Column Desktop Layout)
   -------------------------------------------------------------------------- */
.l1-salary-records-container {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 100%;
}

.l1-salary-month-card {
  background: #ffffff;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 18px 20px;
  box-shadow: 0 2px 8px -2px rgba(10, 42, 122, 0.04);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.l1-salary-month-card:hover {
  border-color: #CBD5E1;
  box-shadow: 0 4px 14px -2px rgba(10, 42, 122, 0.08);
}

.l1-salary-month-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid #F1F5F9;
}

.l1-salary-month-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.l1-salary-month-badge {
  font-size: 12px;
  font-weight: 700;
  background: #EFF6FF;
  color: var(--blue);
  padding: 4px 12px;
  border-radius: 99px;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

.l1-salary-month-period {
  font-size: 14px;
  font-weight: 600;
  color: var(--ink);
}

.l1-btn-remove-salary-month {
  background: #FEF2F2;
  border: 1px solid #FCA5A5;
  color: #DC2626;
  font-size: 12.5px;
  font-weight: 600;
  padding: 5px 12px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.l1-btn-remove-salary-month:hover {
  background: #FEE2E2;
  border-color: #F87171;
}

.l1-salary-six-col-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12px 14px;
  width: 100%;
}

.l1-salary-col {
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-width: 0;
}

.l1-salary-col-span-2 {
  grid-column: span 2;
}

.l1-salary-label {
  font-size: 11.5px;
  font-weight: 600;
  color: var(--mut);
  text-transform: uppercase;
  letter-spacing: 0.03em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.l1-salary-control {
  width: 100%;
  height: 40px;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 0 12px;
  font-size: 13.5px;
  background: #ffffff;
  color: var(--ink);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  box-sizing: border-box;
}

.l1-salary-control:focus {
  border-color: var(--blue);
  outline: none;
  box-shadow: 0 0 0 3px rgba(11, 79, 184, 0.1);
}

.l1-salary-control:disabled {
  background: #F8FAFC;
  color: #94A3B8;
  cursor: not-allowed;
}

.l1-salary-control.text-right {
  text-align: right;
  font-family: monospace;
}

/* Responsive adjustments for Section 3 Six-Column Layout */
@media (max-width: 1120px) {
  .l1-salary-six-col-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  .l1-salary-col-span-2 {
    grid-column: span 1;
  }
}

@media (max-width: 640px) {
  .l1-salary-six-col-grid {
    grid-template-columns: 1fr;
  }
  .l1-salary-col-span-2 {
    grid-column: span 1;
  }
}

/* Synchronized Period Indicator in Document Workspaces */
.l1-sync-period-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #F0FDF4;
  border: 1px solid #BBF7D0;
  color: #166534;
  padding: 8px 14px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 600;
}

.l1-sync-tag {
  font-size: 10.5px;
  background: #DCFCE7;
  color: #15803D;
  padding: 2px 7px;
  border-radius: 4px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

/* --------------------------------------------------------------------------
   Salary Calculation Summary Bar
   -------------------------------------------------------------------------- */
.l1-salary-summary-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 12px;
  background: #F8FAFC;
  padding: 14px 18px;
  border-radius: 14px;
  border: 1px solid var(--line);
}

.l1-salary-stat {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.l1-salary-stat .label {
  font-size: 11.5px;
  color: var(--mut);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.l1-salary-stat .val {
  font-size: 16px;
  font-weight: 700;
  color: var(--ink);
  font-family: monospace;
}

.l1-salary-stat .val.highlight {
  color: var(--blue);
}

/* --------------------------------------------------------------------------
   Document Compliance Matrix & Sign-off Cards
   -------------------------------------------------------------------------- */
.l1-compliance-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 14px;
}

.l1-compliance-card {
  background: #ffffff;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.l1-compliance-card.verified {
  border-left: 4px solid var(--ok);
}

.l1-compliance-card.pending {
  border-left: 4px solid #EAB308;
}

.l1-compliance-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.l1-compliance-title {
  font-weight: 700;
  font-size: 14px;
  color: var(--ink);
}

.l1-signoff-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 16px;
}

.l1-signoff-card {
  background: #F8FAFC;
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.l1-signoff-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--line);
  padding-bottom: 8px;
}

.l1-signoff-role {
  font-size: 14px;
  font-weight: 700;
  color: var(--blue);
}

.l1-field-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.l1-field-group label {
  font-size: 12px;
  font-weight: 600;
  color: var(--mut);
}

.l1-field-group input,
.l1-field-group textarea {
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 13px;
  background: #ffffff;
  color: var(--ink);
}

.l1-checkbox-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
  color: var(--ink);
  cursor: pointer;
}

/* --------------------------------------------------------------------------
   Toast Banner
   -------------------------------------------------------------------------- */
.l1-audit-toast {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  background: #0E1424;
  color: #ffffff;
  padding: 12px 24px;
  border-radius: 99px;
  font-size: 14px;
  font-weight: 500;
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
  z-index: 200;
  display: flex;
  align-items: center;
  gap: 10px;
  animation: l1ToastUp 0.25s ease-out;
}

.l1-audit-toast.success {
  background: #14532D;
  border: 1px solid #22C55E;
}

.l1-audit-toast.error {
  background: #7F1D1D;
  border: 1px solid #EF4444;
}

@keyframes l1ToastUp {
  from {
    opacity: 0;
    transform: translate(-50%, 16px);
  }
  to {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

/* ==========================================================================
   C-PASS Candidate Placement Audit & Sign-off Statement — Printable Document
   ========================================================================== */
.l1-statement-modal-card {
  background: #ffffff;
  border-radius: 20px;
  width: min(940px, 98vw);
  max-height: 92vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(10, 42, 122, 0.35);
  border: 1px solid var(--line);
}

.cpass-statement-sheet {
  background: #ffffff;
  padding: clamp(20px, 3.5vw, 40px);
  display: flex;
  flex-direction: column;
  gap: 20px;
  color: #111827;
  font-size: 12.5px;
  line-height: 1.45;
}

.cpass-statement-header {
  border-bottom: 2px solid #0B4FB8;
  padding-bottom: 14px;
  gap: 16px;
}

.cpass-header-logo img {
  height: 48px;
  width: auto;
  object-fit: contain;
}

.cpass-header-title {
  text-align: center;
  flex: 1;
}

.cpass-header-title h2 {
  margin: 0;
  font-size: 18px;
  font-weight: 800;
  color: #0A2A7A;
  letter-spacing: 0.01em;
}

.cpass-header-title h4 {
  margin: 3px 0 0;
  font-size: 13.5px;
  font-weight: 700;
  color: #0B4FB8;
}

.cpass-header-title p {
  margin: 2px 0 0;
  font-size: 11px;
  color: #6B7280;
}

.cpass-header-meta {
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 11.5px;
  color: #4B5563;
}

.cpass-statement-section-title {
  background: #EEF3FC;
  border-left: 4px solid #0B4FB8;
  padding: 6px 12px;
  font-size: 13px;
  font-weight: 700;
  color: #0A2A7A;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.cpass-dossier-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px 14px;
  background: #F9FAFB;
  border: 1px solid #E5E7EB;
  border-radius: 8px;
  padding: 12px 16px;
}

.cpass-dossier-item {
  display: flex;
  flex-direction: column;
}

.cpass-dossier-item .k {
  font-size: 11px;
  color: #6B7280;
  font-weight: 500;
}

.cpass-dossier-item .v {
  font-size: 12.5px;
  font-weight: 700;
  color: #111827;
}

.cpass-doc-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

.cpass-doc-table th {
  background: #F3F4F6;
  border: 1px solid #D1D5DB;
  padding: 7px 10px;
  font-weight: 700;
  text-align: left;
  color: #374151;
  font-size: 11.5px;
}

.cpass-doc-table td {
  border: 1px solid #E5E7EB;
  padding: 6px 10px;
  color: #1F2937;
}

.cpass-doc-table tr:nth-child(even) td {
  background: #F9FAFB;
}

.cpass-doc-table tfoot td {
  background: #F3F4F6;
  font-weight: 700;
  border-top: 2px solid #9CA3AF;
}

.cpass-signoff-trio {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-top: 8px;
}

.cpass-signoff-box {
  border: 1px solid #D1D5DB;
  border-radius: 8px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 140px;
  background: #FAFAFA;
}

.cpass-signoff-box-title {
  font-weight: 700;
  font-size: 12.5px;
  color: #0A2A7A;
  border-bottom: 1px dashed #D1D5DB;
  padding-bottom: 6px;
}

.cpass-signoff-details {
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-size: 11.5px;
  color: #374151;
}

.cpass-signoff-line {
  margin-top: 20px;
  border-top: 1px solid #9CA3AF;
  padding-top: 4px;
  text-align: center;
  font-size: 10.5px;
  color: #6B7280;
  font-weight: 600;
}

.cpass-statement-footer {
  border-top: 1px solid #E5E7EB;
  padding-top: 12px;
  display: flex;
  justify-content: space-between;
  font-size: 10.5px;
  color: #9CA3AF;
}

/* --------------------------------------------------------------------------
   Print Optimizations (@media print)
   -------------------------------------------------------------------------- */
@media print {
  @page {
    size: A4 portrait;
    margin: 10mm 10mm 10mm 10mm;
  }

  body {
    background: #ffffff !important;
    color: #000000 !important;
    margin: 0 !important;
    padding: 0 !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }

  /* Structural print isolation: hide all dashboard elements outside statement modal */
  .l1-dashboard > :not(.l1-modal-backdrop) {
    display: none !important;
  }

  /* Hide app navigation, headers, footers, and non-printable elements */
  header.top,
  header.top *,
  .top,
  .top *,
  .logo,
  .user,
  .app-layout > header,
  .l1-hero-banner,
  .l1-compact-summary-row,
  .l2-compact-summary-row,
  .l1-compact-card,
  .l2-compact-card,
  .l1-compact-summary-row *,
  .l2-compact-summary-row *,
  section.l1-compact-summary-row,
  section.l2-compact-summary-row,
  .l1-selector-panel,
  .l1-cand-summary-card,
  .l1-audit-workflow-container,
  .l1-doc-workspace,
  .l1-submit-dock,
  .l1-modal-header,
  .l1-modal-footer,
  .l1-statement-modal-header,
  .l1-statement-modal-footer,
  .l1-empty-state,
  .l1-banner-warning,
  .l1-banner-danger,
  .l1-audit-toast,
  .l1-toast,
  button,
  .l1-no-print {
    display: none !important;
  }

  /* Allow main layout wrappers to flow naturally into print pages */
  .app-layout,
  .content-container,
  .l1-dashboard {
    display: block !important;
    position: static !important;
    overflow: visible !important;
    height: auto !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    border: none !important;
  }

  /* Unconstrain statement modal and outer backdrop */
  .l1-modal-backdrop {
    position: static !important;
    background: none !important;
    padding: 0 !important;
    overflow: visible !important;
    display: block !important;
    height: auto !important;
    width: 100% !important;
    margin: 0 !important;
  }

  .l1-statement-modal-card {
    position: static !important;
    width: 100% !important;
    max-width: 100% !important;
    max-height: none !important;
    height: auto !important;
    border: none !important;
    box-shadow: none !important;
    border-radius: 0 !important;
    overflow: visible !important;
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;
    background: #ffffff !important;
  }

  .l1-statement-modal-scroll {
    overflow: visible !important;
    height: auto !important;
    max-height: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .cpass-statement-sheet {
    padding: 0 !important;
    margin: 0 !important;
    border: none !important;
    box-shadow: none !important;
    border-radius: 0 !important;
    font-size: 10pt !important;
    line-height: 1.35 !important;
    width: 100% !important;
    max-width: 100% !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }

  .cpass-statement-header {
    border-bottom: 2px solid #0A2A7A !important;
    padding-bottom: 8px !important;
    margin-bottom: 12px !important;
  }

  .cpass-statement-section-title {
    background: #EEF3FC !important;
    color: #0A2A7A !important;
    border-left: 4px solid #0B4FB8 !important;
    padding: 4px 8px !important;
    font-size: 10.5pt !important;
    margin-top: 14px !important;
    margin-bottom: 8px !important;
    page-break-after: avoid;
    break-after: avoid;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }

  .cpass-dossier-grid {
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 8px !important;
    page-break-inside: avoid;
    break-inside: avoid;
  }

  .cpass-doc-table {
    width: 100% !important;
    page-break-inside: auto;
    font-size: 9pt !important;
  }

  .cpass-doc-table thead {
    display: table-header-group;
  }

  .cpass-doc-table th,
  .cpass-doc-table tfoot td {
    background: #F3F4F6 !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }

  .cpass-doc-table tr {
    page-break-inside: avoid;
    break-inside: avoid;
  }

  .cpass-signoff-trio {
    page-break-inside: avoid;
    break-inside: avoid;
    gap: 12px !important;
  }

  .cpass-statement-footer {
    border-top: 1px solid #D1D5DB !important;
    margin-top: 14px !important;
    padding-top: 8px !important;
    font-size: 8.5pt !important;
    color: #6B7280 !important;
    page-break-inside: avoid;
    break-inside: avoid;
  }
}

/* ==========================================================================
   CPASS L1 Coordinator Compact Dashboard Summary Cards (Top of Dashboard)
   ========================================================================== */

/* ==========================================================================
   CPASS L1 Coordinator Compact Dashboard Summary Cards (Top of Dashboard)
   Enterprise Design: Crisp White Surfaces, Subtle Accents, Responsive Grid
   ========================================================================== */

.l1-compact-summary-row {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 14px;
  margin-bottom: 22px;
  width: 100%;
}

@media (max-width: 1200px) {
  .l1-compact-summary-row {
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
}

@media (max-width: 768px) {
  .l1-compact-summary-row {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
}

@media (max-width: 420px) {
  .l1-compact-summary-row {
    grid-template-columns: 1fr;
    gap: 8px;
  }
}

.l1-compact-card {
  background: #ffffff;
  border: 1px solid var(--line, #E2E8F0);
  border-radius: 14px;
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 8px;
  cursor: pointer;
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 1px 3px rgba(10, 42, 122, 0.04), 0 1px 2px rgba(10, 42, 122, 0.02);
  user-select: none;
  min-height: 84px;
  position: relative;
  overflow: hidden;
}

.l1-compact-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: transparent;
  transition: background 0.15s ease;
}

/* Card 1: Total - CPASS brand blue */
.l1-compact-card.total::before { background: #0B4FB8; }
/* Card 2: Uploaded - Indigo */
.l1-compact-card.uploaded::before { background: #4F46E5; }
/* Card 3: Approved - Green */
.l1-compact-card.approved::before { background: #16A34A; }
/* Card 4: Rejected - Red */
.l1-compact-card.rejected::before { background: #DC2626; }
/* Card 5: In Progress - Sky Blue */
.l1-compact-card.in-progress::before { background: #0284C7; }
/* Card 6: Pending - Amber */
.l1-compact-card.pending::before { background: #D97706; }

.l1-compact-card:hover {
  transform: translateY(-2px);
  border-color: #CBD5E1;
  box-shadow: 0 6px 16px -2px rgba(10, 42, 122, 0.08);
}

.l1-compact-card:focus-visible {
  outline: 2px solid #0B4FB8;
  outline-offset: 2px;
}

/* Card Active (Selected) State */
.l1-compact-card.active {
  border-color: #0B4FB8;
  background: #F8FAFC;
  box-shadow: 0 0 0 2px #0B4FB8, 0 6px 16px -2px rgba(11, 79, 184, 0.14);
}

.l1-compact-card.active::after {
  content: '';
  position: absolute;
  top: 10px;
  right: 10px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #0B4FB8;
}

.l1-compact-card-meta {
  display: flex;
  align-items: center;
  gap: 8px;
}

.l1-compact-card-icon {
  width: 26px;
  height: 26px;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.l1-compact-card.total .l1-compact-card-icon { background: #EFF6FF; color: #0B4FB8; }
.l1-compact-card.uploaded .l1-compact-card-icon { background: #EEF2FF; color: #4F46E5; }
.l1-compact-card.approved .l1-compact-card-icon { background: #F0FDF4; color: #16A34A; }
.l1-compact-card.rejected .l1-compact-card-icon { background: #FEF2F2; color: #DC2626; }
.l1-compact-card.in-progress .l1-compact-card-icon { background: #F0F9FF; color: #0284C7; }
.l1-compact-card.pending .l1-compact-card-icon { background: #FFFBEB; color: #D97706; }

.l1-compact-card-title {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: #64748B;
}

.l1-compact-card-count {
  font-family: 'Inter Tight', 'Inter', -apple-system, sans-serif;
  font-size: 24px;
  font-weight: 800;
  color: #0E1424;
  line-height: 1.1;
  letter-spacing: -0.025em;
}

.l1-compact-card.total .l1-compact-card-count { color: #0E1424; }
.l1-compact-card.uploaded .l1-compact-card-count { color: #4338CA; }
.l1-compact-card.approved .l1-compact-card-count { color: #15803D; }
.l1-compact-card.rejected .l1-compact-card-count { color: #DC2626; }
.l1-compact-card.in-progress .l1-compact-card-count { color: #0369A1; }
.l1-compact-card.pending .l1-compact-card-count { color: #B45309; }

/* ==========================================================================
   Candidate List Modal / Popup Dialog
   Enterprise Redesign: Stable Header & Footer, Clean Table, Responsive Layout
   ========================================================================== */

.l1-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(14, 20, 36, 0.5);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  animation: l1ModalFadeIn 0.15s ease-out;
}

@keyframes l1ModalFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.l1-cand-popup-dialog {
  background: #ffffff;
  border-radius: 16px;
  width: min(1520px, 95vw);
  max-width: 95vw;
  max-height: min(88vh, 880px);
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 48px -12px rgba(10, 42, 122, 0.25);
  border: 1px solid var(--line, #E2E8F0);
  overflow: hidden;
  animation: l1PopupScaleUp 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes l1PopupScaleUp {
  from {
    opacity: 0;
    transform: scale(0.97) translateY(8px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.l1-cand-popup-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16px 24px 14px;
  border-bottom: 1px solid var(--line, #E2E8F0);
  background: #F8FAFC;
  gap: 16px;
  flex-shrink: 0;
}

.l1-cand-popup-title-group h3 {
  margin: 0;
  font-size: 16.5px;
  font-weight: 700;
  color: var(--ink, #0E1424);
  display: flex;
  align-items: center;
  gap: 8px;
  letter-spacing: -0.01em;
}

.l1-cand-popup-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 6px;
  background: #EFF6FF;
  color: #0B4FB8;
  font-size: 14px;
  flex-shrink: 0;
}

.l1-cand-popup-count-badge {
  background: #0B4FB8;
  color: #ffffff;
  font-size: 11.5px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 99px;
  letter-spacing: 0;
}

.l1-cand-popup-sub {
  margin: 4px 0 0;
  font-size: 12.5px;
  color: var(--mut, #64748B);
  line-height: 1.4;
}

.l1-popup-close-btn {
  background: transparent;
  border: 1px solid transparent;
  color: #64748B;
  font-size: 16px;
  line-height: 1;
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.15s ease;
  flex-shrink: 0;
}

.l1-popup-close-btn:hover {
  background: #E2E8F0;
  color: #0E1424;
}

.l1-popup-close-btn:focus-visible {
  outline: 2px solid #0B4FB8;
  outline-offset: 1px;
}

.l1-cand-popup-toolbar {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 24px;
  background: #ffffff;
  border-bottom: 1px solid #F1F5F9;
  flex-shrink: 0;
}

.l1-cand-popup-search-box {
  display: flex;
  align-items: center;
  gap: 10px;
  background: #ffffff;
  border: 1px solid #CBD5E1;
  border-radius: 8px;
  padding: 0 12px;
  flex: 1;
  height: 40px;
  box-sizing: border-box;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.l1-cand-popup-search-box:focus-within {
  border-color: #0B4FB8;
  box-shadow: 0 0 0 3px rgba(11, 79, 184, 0.12);
}

.l1-search-icon {
  font-size: 14px;
  color: #64748B;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  pointer-events: none;
}

.l1-cand-popup-search-input {
  border: none !important;
  background: transparent !important;
  padding: 0 !important;
  height: 100% !important;
  font-size: 13.5px;
  color: #0E1424;
  width: 100%;
  outline: none !important;
  box-shadow: none !important;
  font-family: inherit;
}

.l1-cand-popup-search-input:focus,
.l1-cand-popup-search-input:focus-visible {
  outline: none !important;
  box-shadow: none !important;
  border: none !important;
}

.l1-cand-popup-search-input::placeholder {
  color: #94A3B8;
