/* ==========================================================================
   Candidate List Modal / Popup Dialog (L2 Summary Cards Drill-Down)
   ========================================================================== */
.l1-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(14, 20, 36, 0.5);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  animation: l1ModalFadeIn 0.15s ease-out;
}

@keyframes l1ModalFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.l1-cand-popup-dialog {
  background: #ffffff;
  border-radius: 16px;
  width: min(1520px, 95vw);
  max-width: 95vw;
  max-height: min(88vh, 880px);
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 48px -12px rgba(10, 42, 122, 0.25);
  border: 1px solid var(--line, #E2E8F0);
  overflow: hidden;
  animation: l1PopupScaleUp 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes l1PopupScaleUp {
  from {
