/* Flexible Return Modal Styles */

.flex-return-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(2px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1050;
  padding: 16px;
  animation: flexFadeIn 0.15s ease-out;
}

@keyframes flexFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.flex-return-card {
  background: #ffffff;
  border-radius: 12px;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  width: 100%;
  max-width: 580px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid #e2e8f0;
}

.flex-return-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}

.flex-return-title-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.flex-return-icon {
  font-size: 24px;
  background: #fef3c7;
  padding: 6px;
  border-radius: 8px;
  line-height: 1;
}

.flex-return-title {
  margin: 0;
  font-size: 15px;
  font-weight: 700;
  color: #0f172a;
}

.flex-return-sub {
  margin: 2px 0 0;
  font-size: 12px;
  color: #64748b;
}

.flex-return-close-btn {
  background: transparent;
  border: none;
  font-size: 16px;
  color: #94a3b8;
  cursor: pointer;
  padding: 4px 8px;
  border-radius: 6px;
}

.flex-return-close-btn:hover {
  background: #e2e8f0;
  color: #334155;
}

.flex-return-body {
  padding: 18px 20px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.flex-return-alert.error {
  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #991b1b;
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 12.5px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.flex-return-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.flex-return-label {
  font-size: 13px;
  font-weight: 600;
  color: #1e293b;
}

.flex-return-label .req {
  color: #dc2626;
}

.flex-return-label .opt {
  color: #64748b;
  font-weight: 400;
  font-size: 11.5px;
}

.flex-return-help {
  margin: 0;
  font-size: 12px;
  color: #64748b;
}

.flex-return-dest-grid {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 4px;
}

.flex-return-dest-option {
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 10px 12px;
  background: #ffffff;
  cursor: pointer;
  transition: all 0.15s ease;
}

.flex-return-dest-option:hover {
  border-color: #cbd5e1;
  background: #f8fafc;
}

.flex-return-dest-option.selected {
  border-color: #2563eb;
  background: #eff6ff;
  box-shadow: 0 0 0 1px #2563eb;
}

