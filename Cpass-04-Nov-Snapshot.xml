  transition: all 0.15s ease;
}

.cpass-profile-save-btn:hover:not(:disabled) {
  background: #1d4ed8;
}

.cpass-profile-save-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

@media (max-width: 480px) {
  .cpass-profile-grid {
    grid-template-columns: 1fr;
  }
}
