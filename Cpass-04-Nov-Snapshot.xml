def test_cops_review_blocked_if_ch_not_recommended():
    """COPS cannot approve or return a candidate until L2 CH has recommended the dossier."""
    app.dependency_overrides[get_current_user] = lambda: L3_USER

    pending_ch_audit = {
        **make_ch_audit(),
        "signoff_details": {
