"""Cascading dropdowns for L1: State -> Centre -> Sanction order -> Batch -> Candidate.

Queries the ddugky_candidates master table with centre scoping and candidate details.
"""

from __future__ import annotations

from typing import Any
from fastapi import APIRouter, Depends, HTTPException

from ..auth import (
    ALL_12_STATES,
    CurrentUser,
    allowed_states,
    allowed_tc_ids,
    check_candidate_access,
    get_candidate_state,
    get_current_user,
    resolve_state,
)
from ..config import settings
from ..db import TRANSIENT_ERRORS, retry_read_query, supabase

router = APIRouter(prefix="/lookups", tags=["lookups"])


def _check_centre(user: CurrentUser, tc_id: int) -> None:
    permitted_st = allowed_states(user)
    if permitted_st is not None:
        if not permitted_st:
            raise HTTPException(403, "You do not have access to any states.")
        # Verify training centre belongs to user's permitted state(s)
        try:
            res = retry_read_query(
                lambda: supabase.table("ddugky_candidates")
                .select("candidate_id,tc_state_name")
                .eq("tc_id", tc_id)
                .limit(10)
                .execute()
            )
            rows = res.data or []
            if rows:
                has_permitted = any(
                    (resolve_state(r.get("tc_state_name")) in permitted_st)
                    for r in rows
                )
                if not has_permitted:
                    raise HTTPException(403, "You do not have access to this training centre.")
            else:
                raise HTTPException(404, "Training centre not found.")
        except HTTPException:
            raise
        except TRANSIENT_ERRORS as exc:
            import logging
            logging.getLogger("cpass.lookups").warning("Transient error during centre check for tc_id %s: %s", tc_id, exc)
            raise HTTPException(
                503,
                "Training centre verification service temporarily unreachable. Please retry.",
                headers={"Retry-After": "1"},
            )
        except Exception:
            raise HTTPException(403, "Authorization check failed for this training centre.")

    allowed = allowed_tc_ids(user)
    if allowed is not None and tc_id not in allowed:
        raise HTTPException(403, "You are not assigned to this training centre.")


def _mask_bank_account(raw: Any) -> str:
    """Mask bank account number, displaying XXXX-XXXX-Last4 or Not Available."""
    if not raw:
        return "Not Available"
    s = str(raw).strip()
    digits = "".join(ch for ch in s if ch.isdigit())
    if len(digits) >= 4:
        return f"XXXX-XXXX-{digits[-4:]}"
    if s.lower() in ("no", "na", "n/a", "none", "0", "nil"):
        return "Not Available"
    return s or "Not Available"


@router.get("/states")
def states(user: CurrentUser = Depends(get_current_user)):
    """Return distinct states permitted for this user.
    L1 coordinators receive only their assigned state.
    Unassigned L1 receives an empty list (fail-closed).
    Admins and executive roles receive all states.
    """
    permitted = allowed_states(user)
    if permitted is not None:
        return sorted(permitted)

    try:
        res = retry_read_query(lambda: supabase.rpc("get_cpass_states", {}).execute())
        rpc_states = {
            row["state"].strip()
            for row in (res.data or [])
            if row.get("state") and row["state"].strip()
        }

        # Query ddugky_candidates for any candidate state_name not included in training centre RPC
        if rpc_states:
            try:
                missing_res = retry_read_query(
                    lambda: supabase.table("ddugky_candidates")
                    .select("tc_state_name")
                    .not_.in_("tc_state_name", tuple(rpc_states))
                    .execute()
                )
                for r in (missing_res.data or []):
                    st = (r.get("tc_state_name") or "").strip()
                    if st:
                        rpc_states.add(st)
            except Exception:
                pass

        all_states = set(ALL_12_STATES)
        all_states.update(rpc_states)
        return sorted(all_states)
    except Exception as exc:
        import logging
        logging.getLogger(__name__).exception("Failed to retrieve CPASS states")
        if permitted is not None:
            return sorted(permitted)
        return sorted(ALL_12_STATES)


@router.get("/centres")
def centres(state: str, user: CurrentUser = Depends(get_current_user)):
    """Return distinct training centres for the given state, respecting user state and centre scoping.
    
    Training Centre State (tc_state_name) is the authoritative source of truth.
    """
    resolved_state = resolve_state(state) or state
    permitted_st = allowed_states(user)
    if permitted_st is not None:
        if not permitted_st or (resolved_state not in permitted_st and state not in permitted_st):
            raise HTTPException(403, f"Access to state '{state}' is forbidden.")

    allowed = allowed_tc_ids(user)
    try:
        res = retry_read_query(
            lambda: supabase.table("ddugky_candidates")
            .select("tc_id,tc_name")
            .eq("tc_state_name", resolved_state)
            .execute()
        )
        tc_dict = {}
        for r in (res.data or []):
            tcid = r.get("tc_id")
            name = r.get("tc_name")
            if tcid and name:
                if allowed is None or tcid in allowed:
                    tc_dict[tcid] = name

        return sorted(
            [{"tc_id": k, "name": v} for k, v in tc_dict.items()],
            key=lambda c: c["name"],
        )
    except HTTPException:
        raise
    except TRANSIENT_ERRORS as exc:
        import logging
        logging.getLogger("cpass.lookups").warning("Transient error querying training centres: %s", exc)
        raise HTTPException(503, "Training centres service temporarily unreachable. Please retry.", headers={"Retry-After": "1"})
    except Exception as exc:
        import logging
        logging.getLogger("cpass.lookups").exception("Failed to query training centres: %s", exc)
        raise HTTPException(500, "Failed to retrieve training centres. Please retry.")


@router.get("/sanction-orders")
def sanction_orders(tc_id: int, user: CurrentUser = Depends(get_current_user)):
    """Return distinct sanction orders for the specified training centre."""
    _check_centre(user, tc_id)
    try:
        res = retry_read_query(
            lambda: supabase.table("ddugky_candidates")
            .select("sanction_order_number")
            .eq("tc_id", tc_id)
            .execute()
        )
        orders = {r["sanction_order_number"] for r in (res.data or []) if r.get("sanction_order_number")}
        return sorted(orders)
    except HTTPException:
        raise
    except TRANSIENT_ERRORS as exc:
        import logging
        logging.getLogger("cpass.lookups").warning("Transient error querying sanction orders: %s", exc)
        raise HTTPException(503, "Sanction orders service temporarily unreachable. Please retry.", headers={"Retry-After": "1"})
    except Exception as exc:
        import logging
        logging.getLogger("cpass.lookups").exception("Failed to query sanction orders: %s", exc)
        raise HTTPException(500, "Failed to retrieve sanction orders. Please retry.")


@router.get("/batches")
def batches(tc_id: int, sanction_order: str, user: CurrentUser = Depends(get_current_user)):
    """Return distinct batches for the centre and sanction order."""
    _check_centre(user, tc_id)
    try:
        res = retry_read_query(
            lambda: supabase.table("ddugky_candidates")
            .select("kb_batch_id,batch_code,trade_name")
            .eq("tc_id", tc_id)
            .eq("sanction_order_number", sanction_order)
            .execute()
        )
        b_dict = {}
        for r in (res.data or []):
            kbid = r.get("kb_batch_id")
            code = r.get("batch_code")
            if kbid and code and kbid not in b_dict:
                b_dict[kbid] = {
                    "kb_batch_id": kbid,
                    "batch_code": code,
                    "trade_name": r.get("trade_name"),
                }
        return sorted(list(b_dict.values()), key=lambda b: str(b["batch_code"]))
    except HTTPException:
        raise
    except TRANSIENT_ERRORS as exc:
        import logging
        logging.getLogger("cpass.lookups").warning("Transient error querying batches: %s", exc)
        raise HTTPException(503, "Batches service temporarily unreachable. Please retry.", headers={"Retry-After": "1"})
    except Exception as exc:
        import logging
        logging.getLogger("cpass.lookups").exception("Failed to query batches: %s", exc)
        raise HTTPException(500, "Failed to retrieve batches. Please retry.")


@router.get("/candidates")
def candidates(kb_batch_id: int, user: CurrentUser = Depends(get_current_user)):
    """Return candidates in a specific batch, filtered by user authorization."""
    permitted_st = allowed_states(user)
    if permitted_st is not None and not permitted_st:
        raise HTTPException(403, "You do not have access to any candidates.")

    try:
        res = retry_read_query(
            lambda: supabase.table("ddugky_candidates")
            .select("candidate_id,candidate_first_name,candidate_last_name,candidate_father_name,appointed,tc_id,tc_state_name")
            .eq("kb_batch_id", kb_batch_id)
            .execute()
        )
        rows = res.data or []
        if not rows:
            return []

        _check_centre(user, rows[0]["tc_id"])
        cands = []
        for r in rows:
            if settings.appointed_only and not r.get("appointed"):
                continue
            if permitted_st is not None:
                cand_st = get_candidate_state(r)
                if not cand_st or cand_st not in permitted_st:
                    continue
            cands.append({
                "candidate_id": r["candidate_id"],
                "first_name": r.get("candidate_first_name"),
                "last_name": r.get("candidate_last_name"),
                "father_name": r.get("candidate_father_name"),
                "appointed": bool(r.get("appointed")),
            })
        return sorted(cands, key=lambda c: (c["first_name"] or "").lower())
    except HTTPException:
        raise
    except TRANSIENT_ERRORS as exc:
        import logging
        logging.getLogger("cpass.lookups").warning("Transient error querying candidates: %s", exc)
        raise HTTPException(503, "Candidates service temporarily unreachable. Please retry.", headers={"Retry-After": "1"})
    except Exception as exc:
        import logging
        logging.getLogger("cpass.lookups").exception("Failed to query candidates: %s", exc)
        raise HTTPException(500, "Failed to retrieve candidates. Please retry.")


@router.get("/candidates/{candidate_id}")
def candidate_detail(candidate_id: int, user: CurrentUser = Depends(get_current_user)):
    """Return full candidate details, duplicate warnings, and submission hold statuses."""
    try:
        cand_res = retry_read_query(
            lambda: supabase.table("ddugky_candidates")
            .select("*")
            .eq("candidate_id", candidate_id)
            .limit(1)
            .execute()
        )
        if not cand_res.data:
            raise HTTPException(404, "Candidate not found.")

        r = cand_res.data[0]
        # State and centre authorization check
        check_candidate_access(user, r)

        # Clean and mask sensitive data
        raw_bank = r.get("bank_account")
        masked_bank = _mask_bank_account(raw_bank)
        addr = r.get("permanent_address") or r.get("permanent_address_village") or "Not Available"
        if addr and str(addr).strip() == "0":
            addr = "Not Available"

        cand = {
            "candidate_id": r["candidate_id"],
            "first_name": r.get("candidate_first_name"),
            "last_name": r.get("candidate_last_name"),
            "father_name": r.get("candidate_father_name") or "Not Available",
            "gender": r.get("gender") or "Not Available",
            "dob": str(r.get("date_of_birth") or "Not Available"),
            "date_of_birth": str(r.get("date_of_birth") or "Not Available"),
            "mobile": r.get("mobile_number") or "Not Available",
            "appointed": bool(r.get("appointed")),
            "employer_name": r.get("employer_name"),
            "kb_batch_id": r.get("kb_batch_id"),
            "batch_code": r.get("batch_code") or "Not Available",
            "batch_start_date": str(r.get("batch_start_date") or "Not Available"),
            "batch_end_date": str(r.get("batch_end_date") or "Not Available"),
            "trade_name": r.get("trade_name") or "Not Available",
            "tc_id": r.get("tc_id"),
            "tc_name": r.get("tc_name"),
            "tc_state_name": r.get("tc_state_name"),
            "state_name": r.get("state_name") or r.get("tc_state_name"),
            "sanction_order_number": r.get("sanction_order_number") or "Not Available",
            "monthly_ctc": r.get("monthly_ctc"),
            "candidate_email": r.get("candidate_email") or "Not Available",
            "candidate_qualification": r.get("candidate_qualification") or "Not Available",
            "address": addr,
            "permanent_address": addr,
            "bank_account": masked_bank,
            "masked_bank_account": masked_bank,
            "aadhar": r.get("aadhar"),
            "aadhaar_number": r.get("aadhar"),
        }

        # Check duplicate warnings & holds if tables exist
        has_warning = False
        warning_text = None
        unresolved_cases = []
        has_hold = False
        active_holds = []

        try:
            member_res = retry_read_query(
                lambda: supabase.table("duplicate_case_members")
                .select("case_id,duplicate_cases!inner(id,rule_code,rule_description,status,severity)")
                .eq("candidate_id", candidate_id)
                .in_("duplicate_cases.status", ["PENDING", "UNDER_REVIEW", "UNRESOLVED"])
                .execute()
            )
            unresolved_cases = [m["duplicate_cases"] for m in (member_res.data or [])]
            has_warning = len(unresolved_cases) > 0
            if has_warning:
                warning_text = f"Candidate has {len(unresolved_cases)} unresolved potential duplicate review case(s)."
        except Exception:
            pass

        try:
            hold_res = retry_read_query(
                lambda: supabase.table("candidate_holds")
                .select("id,hold_reason,placed_by,placed_at")
                .eq("candidate_id", candidate_id)
                .eq("is_active", True)
                .execute()
            )
            active_holds = hold_res.data or []
            has_hold = len(active_holds) > 0
        except Exception:
            pass

        return {
            **cand,
            "has_duplicate_warning": has_warning,
            "warning_message": warning_text,
            "unresolved_cases": unresolved_cases,
            "has_active_hold": has_hold,
            "active_holds": active_holds,
            "can_submit": not has_hold,
        }
    except HTTPException:
        raise
    except TRANSIENT_ERRORS as exc:
        import logging
        logging.getLogger("cpass.lookups").warning("Transient error querying candidate detail: %s", exc)
        raise HTTPException(503, "Candidate details service temporarily unreachable. Please retry.", headers={"Retry-After": "1"})
    except Exception as exc:
        import logging
        logging.getLogger("cpass.lookups").exception("Failed to query candidate detail: %s", exc)
        raise HTTPException(500, "Failed to retrieve candidate detail. Please retry.")
</file>

<file path="frontend/src/components/PlacementAuditStatement.jsx">
import { useMemo } from 'react'
import synchroLogo from '../../assets/SynchroServeLogoHD.png'
import './PlacementAuditStatement.css'

import { getApprovalStatusDetails } from './approvalStatusHelper.js'
export { getApprovalStatusDetails }
import {
  MONTH_NAMES,
  getEmployerSalarySequence,
  formatEmployerSalaryLabel,
  normalizeEmployerId
} from '../lib/salarySequenceHelper'

export default function PlacementAuditStatement({
  statementData,
  isEditMode = false,
  editedData = null,
  onUpdateEmployer = () => { },
  onAddEmployer = () => { },
  onRemoveEmployer = () => { },
  onUpdateSalary = () => { },
  onAddSalary = () => { },
  onRemoveSalary = () => { },
  onUpdateSignoff = () => { },
  onUpdateRemarks = () => { },
  l1OriginalData = null,
  showModalWrapper = false,
  onClose = () => { },
  extraHeaderActions = null,
  extraFooterActions = null,
  hasUnsavedChanges = false,
}) {
  if (!statementData) return null

  const auditStatus = statementData.audit_status || statementData.audit?.audit_status || 'DRAFT'
  const cpassStatus = statementData.cpass_status || statementData.audit?.cpass_status || (auditStatus === 'SUBMITTED' ? 'VERIFIED' : 'Under Audit')
  const finalizedAt = statementData.finalized_at || statementData.audit?.finalized_at
  const cand = statementData.candidate || {}
  const candName = cand.candidate_name || cand.full_name || `${cand.first_name || ''} ${cand.last_name || ''}`.trim() || 'N/A'
  const aadhaarDisplay = cand.masked_aadhaar || (cand.aadhaar_last4 ? `XXXX-XXXX-${cand.aadhaar_last4}` : (cand.aadhaar_number || 'Not Available'))

  // Use edited data if in edit mode, otherwise use saved statement data
  const currentEmployers = isEditMode && editedData?.employer_details
    ? editedData.employer_details
    : (statementData.employer_details || statementData.audit?.employer_details || [])

  const currentSalaries = isEditMode && editedData?.salary_details
    ? editedData.salary_details
    : (statementData.salary_details || statementData.audit?.salary_details || [])

  const currentSignoffs = isEditMode && editedData?.signoff_details
    ? editedData.signoff_details
    : (statementData.signoff_details || statementData.audit?.signoff_details || {})

  const statusInfo = useMemo(() => {
    return getApprovalStatusDetails(statementData, currentSignoffs)
  }, [statementData, currentSignoffs])

  // Calculate live salary summary totals
  const salarySummary = useMemo(() => {
    if (isEditMode && editedData?.salary_details) {
      const rows = editedData.salary_details
      const total_credited = rows.reduce((sum, s) => sum + (Number(s.amount_credited) || 0), 0)
      const total_gross = rows.reduce((sum, s) => sum + (Number(s.gross_salary) || 0), 0)
      const total_deductions = rows.reduce((sum, s) => sum + (Number(s.deductions) || 0), 0)
      const total_net = rows.reduce((sum, s) => sum + (Number(s.net_salary) || 0), 0)
      const avg_gross = rows.length > 0 ? total_gross / rows.length : 0
      return {
        total_credited,
        total_gross,
        total_deductions,
        total_net,
        average_gross: avg_gross,
        average_monthly_gross: avg_gross,
        month_count: rows.length,
      }
    }
    return statementData.salary_summary || {}
  }, [isEditMode, editedData, statementData])

  // Document evidence rows
  const docList = statementData.documents || statementData.uploaded_documents || []

  const getCanonicalEmployerId = (empId) => {
    if (!empId) return currentEmployers[0]?.id || ''
    const s = String(empId).trim()
    const direct = currentEmployers.find((e) => String(e.id).trim() === s)
    if (direct) return String(direct.id).trim()
    const norm = s.startsWith('emp_') ? s.slice(4) : s
    const idx = parseInt(norm, 10)
    if (!isNaN(idx) && idx >= 1 && idx <= currentEmployers.length) {
      return String(currentEmployers[idx - 1]?.id).trim()
    }
    if (currentEmployers.length <= 1 && currentEmployers[0]) {
      return String(currentEmployers[0].id).trim()
    }
    return s
  }

  const matchesEmployer = (docEmpId, targetEmpId) => {
    if (currentEmployers.length <= 1) return true
    if (!docEmpId || !targetEmpId) return true
    const canDoc = getCanonicalEmployerId(docEmpId)
    const canTarget = getCanonicalEmployerId(targetEmpId)
    if (canDoc && canTarget) return canDoc === canTarget
    return String(docEmpId).trim() === String(targetEmpId).trim()
  }

  const evidenceRows = statementData.document_evidence || (currentSalaries.length > 0
    ? [
        {
          code: 'AL / OL',
          label: 'Appointment / Offer Letter',
          key: 'appointment_letter',
          fallbackDoc: docList.find(d => d.document_type === 'APPOINTMENT_LETTER' && d.upload_status === 'SUCCESS'),
        },
        ...currentSalaries.map((sal, idx) => {
          const empSeq = getEmployerSalarySequence(sal, currentSalaries)
          const empObj = currentEmployers.find(e => e.id === sal.employer_id) || currentEmployers[0]
          const empPrefix = currentEmployers.length > 1 ? `${empObj?.employer_name || 'Employer'} • ` : ''
          const mName = MONTH_NAMES[(sal.month || 1) - 1] || `Month ${sal.month}`
          return {
            code: `PS ${empSeq}`,
            label: `Salary Pay Slip — ${empPrefix}Month ${empSeq} (${mName} ${sal.year || ''})`,
            key: `salary_slip_${idx + 1}`,
            fallbackDoc: docList.find(d =>
              d.document_type === 'SALARY_SLIP' &&
              d.upload_status === 'SUCCESS' &&
              (Number(d.reporting_year) === Number(sal.year) && Number(d.reporting_month) === Number(sal.month)) &&
              matchesEmployer(d.employer_id, sal.employer_id)
            ),
          }
        }),
        ...currentSalaries.map((sal, idx) => {
          const empSeq = getEmployerSalarySequence(sal, currentSalaries)
          const empObj = currentEmployers.find(e => e.id === sal.employer_id) || currentEmployers[0]
          const empPrefix = currentEmployers.length > 1 ? `${empObj?.employer_name || 'Employer'} • ` : ''
          const mName = MONTH_NAMES[(sal.month || 1) - 1] || `Month ${sal.month}`
          const sMonth = Number(sal.month)
          const sYear = Number(sal.year)
          const bankDoc = docList.find(d => {
            if (d.document_type !== 'BANK_STATEMENT') return false
            const stUpper = String(d.upload_status || '').toUpperCase()
            if (stUpper !== 'SUCCESS' && d.upload_status && !d.drive_file_id) return false
            if (!matchesEmployer(d.employer_id, sal.employer_id)) return false
            const isConsol = Boolean(
              d.is_consolidated === true ||
              d.is_consolidated === 'true' ||
              d.is_consolidated === 1 ||
              (d.coverage_start_month && d.coverage_end_month && Number(d.coverage_end_month) >= Number(d.coverage_start_month))
            )
            if (isConsol) {
              let covList = d.covered_months
              if (typeof covList === 'string') {
                try { covList = JSON.parse(covList) } catch (_) { covList = [] }
              }
              if (Array.isArray(covList) && covList.length > 0) {
                return covList.some(cm => Number(cm.month) === sMonth && (!cm.year || Number(cm.year) === sYear))
              }
              const s = (Number(d.coverage_start_year || d.reporting_year || sYear) * 12) + Number(d.coverage_start_month || d.reporting_month || 1)
              const e = (Number(d.coverage_end_year || d.reporting_year || sYear) * 12) + Number(d.coverage_end_month || d.reporting_month || 1)
              const c = (sYear * 12) + sMonth
              return c >= s && c <= e
            }
            return Number(d.reporting_year) === sYear && Number(d.reporting_month) === sMonth
          })
          const isConsol = Boolean(
            bankDoc?.is_consolidated === true ||
            bankDoc?.is_consolidated === 'true' ||
            bankDoc?.is_consolidated === 1 ||
            (bankDoc?.coverage_start_month && bankDoc?.coverage_end_month && Number(bankDoc.coverage_end_month) >= Number(bankDoc.coverage_start_month))
          )
          const startM = Number(bankDoc?.coverage_start_month || bankDoc?.reporting_month || 1)
          const startY = Number(bankDoc?.coverage_start_year || bankDoc?.reporting_year || sYear)
          const endM = Number(bankDoc?.coverage_end_month || bankDoc?.reporting_month || startM)
          const endY = Number(bankDoc?.coverage_end_year || bankDoc?.reporting_year || startY)
          const consolSuffix = isConsol ? ' (Consolidated Statement)' : ''
          return {
            code: `BS ${empSeq}`,
            label: `Bank Statement / Passbook — ${empPrefix}Month ${empSeq} (${mName} ${sal.year || ''})${consolSuffix}`,
            key: `bank_statement_${idx + 1}`,
            fallbackDoc: bankDoc,
            isConsolidated: isConsol,
            coverageText: isConsol ? `${MONTH_NAMES[startM - 1]} ${startY} – ${MONTH_NAMES[endM - 1]} ${endY}` : '',
          }
        }),
        {
          code: 'OD',
          label: 'Other Document (Optional)',
          key: 'other_document',
          fallbackDoc: docList.find(d => d.document_type === 'OTHER_DOCUMENT' && d.upload_status === 'SUCCESS'),
        },
      ]
    : [
        {
          code: 'AL / OL',
          label: 'Appointment / Offer Letter',
          key: 'appointment_letter',
          fallbackDoc: docList.find(d => d.document_type === 'APPOINTMENT_LETTER' && d.upload_status === 'SUCCESS'),
        },
        {
          code: 'PS 1',
          label: 'Salary Pay Slip — Month 1',
          key: 'salary_slip_1',
          fallbackDoc: docList.find(d => d.document_type === 'SALARY_SLIP' && d.upload_status === 'SUCCESS' && d.reporting_month === 1),
        },
        {
          code: 'PS 2',
          label: 'Salary Pay Slip — Month 2',
          key: 'salary_slip_2',
          fallbackDoc: docList.find(d => d.document_type === 'SALARY_SLIP' && d.upload_status === 'SUCCESS' && d.reporting_month === 2),
        },
        {
          code: 'PS 3',
          label: 'Salary Pay Slip — Month 3',
          key: 'salary_slip_3',
          fallbackDoc: docList.find(d => d.document_type === 'SALARY_SLIP' && d.upload_status === 'SUCCESS' && d.reporting_month === 3),
        },
        ...[1, 2, 3].map((mIdx) => {
          const bankDoc = docList.find(d => {
            if (d.document_type !== 'BANK_STATEMENT') return false
            const stUpper = String(d.upload_status || '').toUpperCase()
            if (stUpper !== 'SUCCESS' && d.upload_status && !d.drive_file_id) return false
            const isConsol = Boolean(
              d.is_consolidated === true ||
              d.is_consolidated === 'true' ||
              d.is_consolidated === 1 ||
              (d.coverage_start_month && d.coverage_end_month && Number(d.coverage_end_month) >= Number(d.coverage_start_month))
            )
            if (isConsol) {
              let covList = d.covered_months
              if (typeof covList === 'string') {
                try { covList = JSON.parse(covList) } catch (_) { covList = [] }
              }
              if (Array.isArray(covList) && covList.length > 0) {
                return covList.some(cm => Number(cm.month) === mIdx)
              }
              const s = Number(d.coverage_start_month || d.reporting_month || 1)
              const e = Number(d.coverage_end_month || d.reporting_month || 12)
              return mIdx >= s && mIdx <= e
            }
            return Number(d.reporting_month) === mIdx
          })
          const isConsol = Boolean(
            bankDoc?.is_consolidated === true ||
            bankDoc?.is_consolidated === 'true' ||
            bankDoc?.is_consolidated === 1 ||
            (bankDoc?.coverage_start_month && bankDoc?.coverage_end_month && Number(bankDoc.coverage_end_month) >= Number(bankDoc.coverage_start_month))
          )
          return {
            code: `BS ${mIdx}`,
            label: `Bank Statement / Passbook — Month ${mIdx}${isConsol ? ' (Consolidated Statement)' : ''}`,
            key: `bank_statement_${mIdx}`,
            fallbackDoc: bankDoc,
            isConsolidated: isConsol,
          }
        }),
        {
          code: 'OD',
          label: 'Other Document (Optional)',
          key: 'other_document',
          fallbackDoc: docList.find(d => d.document_type === 'OTHER_DOCUMENT' && d.upload_status === 'SUCCESS'),
        },
      ]
  ).map(item => {
    const isConsol = item.isConsolidated
    const consolNote = isConsol ? ' (Consolidated Statement)' : ''
    const docAudit = statementData.document_audit?.[item.key] || {}
    const isExplicitNo = docAudit.available === 'No' || docAudit.available === false
    const availVal = isExplicitNo ? 'No' : (item.fallbackDoc ? 'Yes' : (docAudit.available || 'Pending'))
    const compVal = docAudit.compliance || (isExplicitNo ? 'Non-Compliant' : (item.fallbackDoc ? 'Compliant' : 'Under Verification'))
    const repoVal = item.fallbackDoc ? `Stored in Drive: ${item.fallbackDoc.file_name}${consolNote}` : (isExplicitNo ? 'Document marked unavailable by coordinator' : (item.code === 'OD' ? 'Optional document not provided' : 'No verified file in database'))
    const defaultObs = item.key?.startsWith('salary_slip') ? 'Payslip not available' : (item.key?.startsWith('bank_statement') ? 'Bank statement not available' : 'Document not available')
    const obsVal = docAudit.remarks || (isExplicitNo ? defaultObs : (item.fallbackDoc ? `Verified during placement audit${consolNote}` : (item.code === 'OD' ? 'Optional supporting document' : 'Pending upload and verification')))

    return {
      code: item.code,
      key: item.key,
      label: item.fallbackDoc?.document_title ? `Other Document — ${item.fallbackDoc.document_title}` : item.label,
      available: availVal,
      compliance: compVal,
      repository_status: repoVal,
      observations: obsVal,
      remarks: docAudit.remarks || (isExplicitNo ? defaultObs : ''),
    }
  })

  // Helper to check if a field was changed relative to L1 original submission
  const isChangedFromL1 = (section, idx, field, currentVal) => {
    if (!l1OriginalData) return false
    const origSection = l1OriginalData[section]
    if (!Array.isArray(origSection) || !origSection[idx]) return false
    const origVal = origSection[idx][field]
    return origVal !== undefined && String(origVal) !== String(currentVal)
  }

  const submitter = statementData.submitter || statementData.signoff_details?.submitter || null

  const sheetContent = (
    <div className={`cpass-statement-sheet ${isEditMode ? 'cpass-statement-editing' : ''}`}>
      {/* Edit Mode Notice Banner */}
      {isEditMode && (
        <div className="l1-no-print" style={{ marginBottom: '14px', padding: '10px 14px', background: '#FEF3C7', border: '1px solid #F59E0B', borderRadius: '6px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
            <span style={{ fontSize: '16px' }}>✏️</span>
            <span style={{ fontSize: '13px', fontWeight: 600, color: '#92400E' }}>
              Statement Edit Mode Active — Edit placement or salary data. L1 original values are preserved in history.
            </span>
          </div>
          {hasUnsavedChanges && (
            <span style={{ fontSize: '11px', background: '#DC2626', color: '#fff', padding: '2px 8px', borderRadius: '4px', fontWeight: 700 }}>
              Unsaved Changes
            </span>
          )}
        </div>
      )}

      {/* Header */}
      <div className="cpass-statement-header">
        <div className="cpass-header-logo">
          <img src={synchroLogo} alt="SynchroServe Logo" />
        </div>
        <div className="cpass-header-title">
          <h2>SYNCHROSERVE GLOBAL SOLUTIONS PRIVATE LIMITED</h2>
          <h4>C-PASS STATEMENT</h4>
          <p>
            Deen Dayal Upadhyaya Grameen Kaushalya Yojana<br />
          </p>
        </div>
        <div className="cpass-header-meta">
          <div><strong>Doc Ref:</strong> CPASS-AUD-{cand.candidate_id || cand.id || 'REF'}</div>
          <div><strong>Date:</strong> {statementData.generated_at ? new Date(statementData.generated_at).toLocaleDateString('en-IN') : new Date().toLocaleDateString('en-IN')}</div>
          {submitter && (
            <div>
              <strong>Submitted By:</strong> {submitter.name || 'Placement Executive'}
            </div>
          )}
          <div>
            <strong>Overall Status:</strong>{' '}
            <span className={`cpass-status-badge ${statusInfo.overallBadgeClass}`}>
              {statusInfo.overallStatus}
            </span>
          </div>
        </div>
      </div>

      {/* Section 1: Candidate Dossier */}
      <div>
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
          <h5 className="cpass-statement-section-title">1. Candidate Dossier &amp; Training Details</h5>
          {isEditMode && (
            <span style={{ fontSize: '11px', color: '#6B7280', fontStyle: 'italic' }}>
              🔒 Master Record (Read-Only)
            </span>
          )}
        </div>
        <div className="cpass-dossier-grid">
          <div className="cpass-dossier-item">
            <span className="k">Candidate Name</span>
            <span className="v">{candName}</span>
          </div>
          <div className="cpass-dossier-item">
            <span className="k">Candidate ID</span>
            <span className="v">{cand.candidate_id || cand.id || 'N/A'}</span>
          </div>
          <div className="cpass-dossier-item">
            <span className="k">Aadhaar (Last 4)</span>
            <span className="v">{aadhaarDisplay}</span>
          </div>
          <div className="cpass-dossier-item">
            <span className="k">Father's Name</span>
            <span className="v">{cand.father_name || 'N/A'}</span>
          </div>
          <div className="cpass-dossier-item">
            <span className="k">Gender / DOB</span>
            <span className="v">{cand.gender || 'N/A'}{cand.dob && cand.dob !== 'Not Available' ? ` • ${cand.dob}` : (cand.date_of_birth && cand.date_of_birth !== 'Not Available' ? ` • ${cand.date_of_birth}` : '')}</span>
          </div>
          <div className="cpass-dossier-item">
            <span className="k">Contact / Email</span>
            <span className="v">{cand.contact_number || cand.mobile || 'N/A'}{cand.candidate_email && cand.candidate_email !== 'Not Available' ? ` • ${cand.candidate_email}` : ''}</span>
          </div>
          <div className="cpass-dossier-item">
            <span className="k">Training Centre</span>
            <span className="v">{cand.training_centre || cand.training_centre_name || cand.tc_name || 'N/A'}</span>
          </div>
          <div className="cpass-dossier-item">
            <span className="k">Trade / Course</span>
            <span className="v">{cand.trade_name || cand.trade || cand.sector_name || cand.sector || 'N/A'}</span>
          </div>
          <div className="cpass-dossier-item">
            <span className="k">Sanction Order</span>
            <span className="v">{cand.sanction_order || cand.sanction_order_name || 'N/A'}</span>
          </div>
          <div className="cpass-dossier-item">
            <span className="k">Batch Code &amp; Dates</span>
            <span className="v">{cand.batch_code || cand.batch_id || 'N/A'}{cand.batch_start_date && cand.batch_start_date !== 'Not Available' ? ` (${cand.batch_start_date} to ${cand.batch_end_date || '—'})` : ''}</span>
          </div>
          <div className="cpass-dossier-item">
            <span className="k">State</span>
            <span className="v">{cand.state || 'N/A'}</span>
          </div>
          <div className="cpass-dossier-item">
            <span className="k">Bank Account</span>
            <span className="v">{cand.masked_bank_account || cand.bank_account || 'Not Available'}</span>
          </div>
          <div className="cpass-dossier-item">
            <span className="k">Review Status</span>
            <span className="v">{statusInfo.reviewStatusDetail}</span>
          </div>
          <div className="cpass-dossier-item">
            <span className="k">Audit Finalized At</span>
            <span className="v">{finalizedAt ? new Date(finalizedAt).toLocaleDateString('en-IN') : (auditStatus === 'SUBMITTED' ? new Date().toLocaleDateString('en-IN') : 'Pending Final Submission')}</span>
          </div>
        </div>
      </div>

      {/* Section 2: Employer Details */}
      <div>
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
          <h5 className="cpass-statement-section-title">2. Placement &amp; Employer Information</h5>
          {isEditMode && currentEmployers.length < 5 && (
            <button
              type="button"
              className="l1-btn-add-slot l1-no-print"
              onClick={onAddEmployer}
              style={{ width: 'auto', padding: '4px 10px', fontSize: '12px' }}
            >
              + Add Employer
            </button>
          )}
        </div>
        <div className="cpass-table-responsive">
          <table className="cpass-doc-table">
            <thead>
              <tr>
                <th style={{ width: '36px' }}>#</th>
