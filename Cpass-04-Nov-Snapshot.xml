}

/* Specific 6-Column Alignment Rules (L2, L3, L4, L5) */
.l1-cand-table th.l1-th-name,
.l1-cand-table td.l1-td-name {
  text-align: left !important;
  padding-left: 20px !important;
  padding-right: 14px !important;
}

.l1-cand-table th.l1-th-state,
.l1-cand-table td.l1-td-state {
