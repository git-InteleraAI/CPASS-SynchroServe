<file path="frontend/src/pages/Login.css">
/* ==========================================================================
   CPASS Sign-In Styles (Faithful Viewport-Aware Responsive Implementation)
   ========================================================================== */

#login {
  --bg: #F3F6FB;
  --card: #fff;
  --ink: #0E1424;
  --mut: #5E6478;
  --line: #E4E8F1;
  --blue: #0B4FB8;
  --red: #F4000F;
  --mag: #B0146A;
  --ok: #0F8A4B;
  --okbg: #E4F5EC;
  --navy: #0A2A7A;
  --soft: #EEF3FC;
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
  min-height: 100vh;
  min-height: 100dvh;
  height: 100dvh;
  max-height: 100dvh;
  overflow: hidden;
  display: grid;
  place-items: center;
  padding: clamp(10px, 2vh, 24px);
  background: radial-gradient(1200px 600px at 80% -10%, #2A6BE0 0, transparent 60%), linear-gradient(160deg, #0A3A9C, #0B2C7A);
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  color: var(--ink);
  -webkit-font-smoothing: antialiased;
}

/* Dark mode media query disabled to enforce light theme application-wide */

#login * {
  box-sizing: border-box;
}

#login button,
#login select,
#login input {
  font: inherit;
  color: inherit;
}

#login :focus-visible {
  outline: 3px solid var(--blue);
  outline-offset: 2px;
}

#login .shell {
  width: min(1180px, 100%);
  height: 100%;
  max-height: min(720px, calc(100dvh - clamp(20px, 4vh, 48px)));
  min-height: 0;
  background: var(--card);
  border-radius: clamp(24px, 3.5vw, 44px);
  padding: clamp(10px, 1.2vw, 14px);
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
  gap: clamp(10px, 1.5vw, 16px);
  box-shadow: 0 20px 50px -20px rgba(10, 42, 122, 0.45);
}

#login .fside {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(14px, 2.5vh, 28px) clamp(20px, 4vw, 54px);
  gap: 0;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

#login .fside .logo {
  height: clamp(42px, 4.4vh, 38px);
  width: auto;
  margin-bottom: clamp(14px, 2.8vh, 32px);
  align-self: flex-start;
  display: block;
  object-fit: contain;
}

#login .badge {
  align-self: flex-start;
  background: var(--soft);
  color: var(--blue);
  font-weight: 500;
  font-size: clamp(12px, 1.6vh, 13.5px);
  padding: clamp(4px, 0.8vh, 7px) clamp(10px, 1.5vw, 14px);
  border-radius: 99px;
  margin-bottom: clamp(10px, 1.8vh, 18px);
  text-transform: none;
  letter-spacing: normal;
  display: inline-block;
  border: none;
}

#login h1 {
  font: 700 clamp(28px, 3.8vw, 48px)/1.04 'Inter Tight', sans-serif;
  letter-spacing: -.035em;
  margin: 0 0 clamp(8px, 1.5vh, 14px);
  color: var(--ink);
}

#login h1 .line {
  display: block;
  font-size: clamp(28px, 2.6vw, 48px);
}

#login .sub {
  color: var(--mut);
  max-width: 44ch;
  margin: 0 0 clamp(12px, 2vh, 22px);
  font-size: clamp(13px, 1.5vh, 14.5px);
  line-height: 1.45;
}

#login form {
  display: grid;
  gap: clamp(8px, 1.4vh, 13px);
  max-width: 420px;
  width: 100%;
}

#login label.f {
  display: grid;
  gap: 4px;
  font-weight: 500;
  font-size: 13px;
  color: var(--ink);
}

#login .in {
  height: clamp(42px, 5vh, 48px);
  border: 1.5px solid var(--line);
  border-radius: 99px;
  padding: 0 18px;
  background: var(--card);
  width: 100%;
  font-size: 14px;
  color: var(--ink);
  transition: border-color .2s, box-shadow .2s;
}

#login .in:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 4px rgba(11, 79, 184, .14);
  outline: 0;
}

#login .pw {
  position: relative;
  display: block;
}

#login .pw button {
  position: absolute;
  right: 6px;
  top: 50%;
  transform: translateY(-50%);
  height: 32px;
  border: 0;
  background: none;
  color: var(--mut);
  padding: 0 12px;
  border-radius: 99px;
  cursor: pointer;
  font-size: 12.5px;
  font-weight: 500;
  line-height: 32px;
}

#login .pw button:hover {
  color: var(--ink);
}

#login .row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
  color: var(--mut);
  margin-top: -2px;
}

#login .row label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 400;
  font-size: 13px;
  cursor: pointer;
}

#login .row input[type="checkbox"] {
  width: 15px;
  height: 15px;
  margin: 0;
  cursor: pointer;
}

#login .row a {
  color: var(--blue);
  text-decoration: none;
  font-weight: 500;
}

#login .row a:hover {
  text-decoration: underline;
}

#login .btn {
  height: clamp(44px, 5.2vh, 50px);
  border: 0;
  border-radius: 99px;
  background: linear-gradient(100deg, var(--blue), #1C6BEA);
  color: #fff;
  font-weight: 600;
  font-size: 14.5px;
  cursor: pointer;
  padding: 0 24px;
  transition: transform .2s, box-shadow .2s;
  box-shadow: 0 10px 24px -10px rgba(11, 79, 184, .7);
  display: block;
  text-align: center;
}

#login .btn:hover:not(:disabled) {
  transform: translateY(-2px);
}

#login .btn:active:not(:disabled) {
  transform: scale(.98);
}

#login .btn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

#login .ring {
  display: block;
  border: 1.5px dashed var(--blue);
  border-radius: 99px;
  padding: 4px;
}

#login .hint {
  font-size: 12.5px;
  color: var(--mut);
  margin: 1px 0 0;
}

#login .fg {
  display: grid;
  gap: 6px;
  font-weight: 500;
  font-size: 13px;
  color: var(--ink);
}

#login .tabs {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-bottom: 1.5px solid var(--line);
}

#login .tab {
  background: none;
  border: 0;
  padding: 4px 2px 9px;
  cursor: pointer;
  color: var(--mut);
  font-weight: 500;
  font-size: 13.5px;
  line-height: 1.2;
  text-align: center;
  transition: color .25s;
  border-radius: 0;
}

#login .tab small {
  display: block;
  font-size: 11px;
  font-weight: 500;
  opacity: .7;
  transition: color .25s;
}

#login .tab:hover {
  color: var(--ink);
}

#login .tab.on {
  color: var(--ink);
  font-weight: 600;
}

#login .tab.on small {
  color: var(--blue);
  opacity: 1;
}

#login .ul {
  position: absolute;
  bottom: -1.5px;
  left: 0;
  width: 25%;
  height: 3px;
  border-radius: 3px;
  background: linear-gradient(90deg, var(--blue), var(--red));
  transition: transform .4s cubic-bezier(.2, .8, .2, 1);
  pointer-events: none;
}

#login .art {
  position: relative;
  border-radius: clamp(20px, 2.5vw, 32px);
  overflow: hidden;
  height: 100%;
  min-height: 0;
  background: radial-gradient(500px 360px at 20% 10%, rgba(80, 160, 255, .55), transparent 70%),
              radial-gradient(520px 380px at 90% 100%, rgba(176, 20, 106, .75), transparent 70%),
              linear-gradient(150deg, #0A2478, #0B4FB8 55%, #7A1C86);
}

#login #stage {
  position: absolute;
  inset: 0;
  cursor: grab;
  touch-action: pan-y;
  user-select: none;
}

#login #stage.drag {
  cursor: grabbing;
}

#login .card {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

#login .ci {
  position: absolute;
  overflow: hidden;
  padding: calc(10px * var(--k, 1));
  color: #fff;
  display: flex;
  flex-direction: column;
  gap: calc(7px * var(--k, 1));
  font-size: calc(13px * var(--k, 1));
  font-weight: 600;
}

#login .ci .ic {
  width: calc(30px * var(--k, 1));
  height: calc(30px * var(--k, 1));
  border-radius: 50%;
  background: rgba(255, 255, 255, .22);
  backdrop-filter: blur(6px);
  display: grid;
  place-items: center;
  font-style: normal;
}

#login .ci b {
  font-weight: 600;
  margin-top: auto;
  color: #fff;
}

#login .ci .bar {
  height: calc(5px * var(--k, 1));
  border-radius: 9px;
  background: rgba(255, 255, 255, .35);
}

#login .ci .bar.s {
  width: 60%;
}

#login .ci em {
  font-style: normal;
  font-size: .82em;
  background: rgba(255, 255, 255, .2);
  border-radius: 99px;
  padding: 2px 8px;
  align-self: flex-start;
}

#login .note {
  position: absolute;
  font: 600 clamp(20px, 2.2vw, 28px)/1 Caveat, cursive;
  color: #fff;
  pointer-events: none;
}

#login .doodle {
  position: absolute;
  pointer-events: none;
  overflow: visible;
}

#login .doodle path {
  fill: none;
  stroke: #fff;
  stroke-width: 3;
  stroke-linecap: round;
  stroke-linejoin: round;
}

#login .toast,
.toast {
  position: fixed;
  left: 50%;
  bottom: calc(24px + env(safe-area-inset-bottom, 0px));
  transform: translateX(-50%);
  background: #0E1424;
  color: #fff;
  padding: 12px 20px;
  border-radius: 99px;
  font-size: 14px;
  z-index: 60;
  box-shadow: 0 14px 30px -10px rgba(0, 0, 0, .5);
  max-width: 90vw;
  pointer-events: none;
}

#login .auth-error-msg {
  color: var(--red);
  font-size: 13px;
  font-weight: 500;
  background: rgba(244, 0, 15, 0.08);
  border: 1px solid rgba(244, 0, 15, 0.2);
  border-radius: 12px;
  padding: 8px 12px;
  margin: 0;
}

/* ==========================================================================
   Mobile & Tablet: Vertical Scrolling Allowed, Single Column, No Clipping
   ========================================================================== */

@media (max-width: 820px) {
  #login {
    height: auto;
    min-height: 100dvh;
