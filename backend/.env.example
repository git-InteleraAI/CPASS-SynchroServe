SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=put-service-role-key-here
# Optional publishable/anon key used for server-side auth password sign-in (falls back to service-role key if omitted)
SUPABASE_ANON_KEY=put-anon-key-here
# Allowed frontend origins (comma-separated for multiple, e.g. production Vercel + local dev)
FRONTEND_ORIGIN=https://cpass-synchro-serve.vercel.app,http://localhost:5173
# Show only appointed candidates in the L1 candidate dropdown (to be confirmed with business)
APPOINTED_ONLY=false
# Set COOKIE_SECURE=true and COOKIE_SAMESITE=none on production Render deployment with HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google Drive Integration (service account file/json OR OAuth2 credentials)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_service_account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-root-folder-id
# Optional OAuth2 alternative:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
